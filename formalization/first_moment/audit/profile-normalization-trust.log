@InhomogeneousShuffle.FirstMoment.Model.exceptionalPositions_source_eq : ∀ {D : Riffle.Model} (A : Riffle.Setup D)
  (P : TimeProfile.BorelPartition D.k) (chi : ℝ) (y z x : Riffle.Word) (hx : Riffle.Legal D x),
