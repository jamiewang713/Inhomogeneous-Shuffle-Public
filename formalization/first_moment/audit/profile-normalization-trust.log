@InhomogeneousShuffle.FirstMoment.Model.profileH_source_eq : ∀ {D : Riffle.Model} {R : ℕ} (A : Riffle.Setup D)
  (P : TimeProfile.BorelPartition D.k) (timeClass : Fin D.K → Fin R) (chi : ℝ) (y z x : Riffle.Word)
  (hx : Riffle.Legal D x),
  TimeProfile.profileH D.N (InhomogeneousShuffle.FirstMoment.Model.asProfile D)
      (InhomogeneousShuffle.FirstMoment.Model.legalVector x hx) P timeClass chi (List.length (Riffle.join y z))
