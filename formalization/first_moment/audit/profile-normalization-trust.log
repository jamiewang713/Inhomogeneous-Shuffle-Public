@InhomogeneousShuffle.FirstMoment.Model.digitCount_source_eq : ∀ {D : Riffle.Model} {R : ℕ} (A : Riffle.Setup D)
  (P : TimeProfile.BorelPartition D.k) (timeClass : Fin D.K → Fin R) (chi : ℝ) (y z x : Riffle.Word)
  (hx : Riffle.Legal D x) (a : Fin R × Fin P.cellCount × Fin D.k),
  TimeProfile.digitCount D.N (InhomogeneousShuffle.FirstMoment.Model.asProfile D)
      (InhomogeneousShuffle.FirstMoment.Model.legalVector x hx) P timeClass chi (List.length (Riffle.join y z))
      (List.length x) a =
    ↑(InhomogeneousShuffle.FirstMoment.Model.goodDigitCount A
          (InhomogeneousShuffle.FirstMoment.Model.sourceCell D P timeClass)
          (InhomogeneousShuffle.FirstMoment.Model.sourceGood D P chi) y z x (finProdFinEquiv (a.1, a.2.1)) a.2.2) /
      Real.log ↑D.N
