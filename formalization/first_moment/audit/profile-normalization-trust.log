@InhomogeneousShuffle.FirstMoment.Model.profileFibre_card_le_rpow_profileH : ∀ {D : Riffle.Model} {R : ℕ}
  (A : Riffle.Setup D) (P : TimeProfile.BorelPartition D.k) (timeClass : Fin D.K → Fin R) (chi alpha : ℝ)
  (route :
    InhomogeneousShuffle.FirstMoment.Model.ProfileWord A (InhomogeneousShuffle.FirstMoment.Model.sourceGood D P chi)
        alpha →
      Fin 4)
  (p :
    InhomogeneousShuffle.FirstMoment.Model.ProfileWord A (InhomogeneousShuffle.FirstMoment.Model.sourceGood D P chi)
      alpha),
  ↑(Nat.card
        (InhomogeneousShuffle.FirstMoment.Model.ProfileFibre A
          (InhomogeneousShuffle.FirstMoment.Model.sourceCell D P timeClass)
          (InhomogeneousShuffle.FirstMoment.Model.sourceGood D P chi) alpha route
          (InhomogeneousShuffle.FirstMoment.Model.encodeProfile A
            (InhomogeneousShuffle.FirstMoment.Model.sourceCell D P timeClass)
            (InhomogeneousShuffle.FirstMoment.Model.sourceGood D P chi) alpha route p))) ≤
    ↑D.N ^
      TimeProfile.profileH D.N (InhomogeneousShuffle.FirstMoment.Model.asProfile D)
        (InhomogeneousShuffle.FirstMoment.Model.legalVector (↑p).2.2 ⋯) P timeClass chi
        (List.length (Riffle.join (↑p).1 (↑p).2.1)) (List.length (↑p).2.2)
