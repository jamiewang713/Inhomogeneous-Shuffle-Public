 - h / 2 ∧ z ≤ 2 * RiffleLowerV2.kappa0 eta","type_dependencies":["Nat","LE.le","instLENat","OfNat.ofNat","instOfNatNat","TimeProfile.Cuts","LT.lt","instLTNat","Real","Real.instLT","Zero.toOfNat0","Real.instZero","TimeProfile.BorelPartition","RiffleLowerV2.ColdWitnessData","RiffleLowerV2.ColdGeometryData","RiffleLowerV2.WitnessSpec","RiffleLowerV2.TypeApproximation","RiffleLowerV2.prefixColumns","RiffleLowerV2.ColdWitnessData.theta","RiffleLowerV2.Localization.geometryError","RiffleLowerV2.ColdGeometryData.prefixType","RiffleLowerV2.tailColumns","instOfNatAtLeastTwo","Real.instNatCast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","RiffleLowerV2.ColdGeometryData.tailType","RiffleLowerV2.BridgeSpec","Real.instLE","HMul.hMul","instHMul","Real.instMul","HAdd.hAdd","instHAdd","Real.instAdd","HDiv.hDiv","instHDiv","DivInvMonoid.toDiv","Real.instDivInvMonoid","One.toOfNat1","Real.instOne","TimeProfile.logScale","Real.log","Nat.cast","RiffleLowerV2.kappa0","RiffleLowerV2.beta","RiffleLowerV2.ColdWitnessData.s","RiffleLowerV2.geometryEllP","RiffleLowerV2.typeH","RiffleLowerV2.geometryH","RiffleLowerV2.geometryZ","RiffleLowerV2.geometryG","And","RiffleLowerV2.kappa","HSub.hSub","instHSub","Real.instSub"],"value":"","value_dependencies":["Nat","LE.le","instLENat","OfNat.ofNat","instOfNatNat","TimeProfile.Cuts","LT.lt","instLTNat","Real","Real.instLT","Zero.toOfNat0","Real.instZero","TimeProfile.BorelPartition","RiffleLowerV2.ColdWitnessData","RiffleLowerV2.ColdGeometryData","RiffleLowerV2.WitnessSpec","RiffleLowerV2.TypeApproximation","RiffleLowerV2.prefixColumns","RiffleLowerV2.ColdWitnessData.theta","RiffleLowerV2.Localization.geometryError","RiffleLowerV2.ColdGeometryData.prefixType","RiffleLowerV2.tailColumns","instOfNatAtLeastTwo","Real.instNatCast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","RiffleLowerV2.ColdGeometryData.tailType","RiffleLowerV2.BridgeSpec","Real.instLE","HMul.hMul","instHMul","Real.instMul","HAdd.hAdd","instHAdd","Real.instAdd","HDiv.hDiv