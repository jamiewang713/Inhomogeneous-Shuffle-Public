DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"RiffleLowerV2.Localization.relative_rank_decomposition","type":"∀ {k N K l m : ℕ} {cuts : TimeProfile.Cuts k N K},\n  l ≤ m →\n    m ≤ K →\n      ∀ (a w : RiffleLowerV2.Word k K) (x : RiffleLowerV2.WordOn k (RiffleLowerV2.columnSet K l m)),\n        List.take l (List.Vector.toList w) = List.take l (List.Vector.toList a) →\n          RiffleLowerV2.restrictWord (RiffleLowerV2.columnSet K l m) w = x →\n            ∀ (omega : RiffleLowerV2.Sample cuts),\n              RiffleLowerV2.lowerRank (RiffleLowerV2.prefixAt m w) omega =\n                  RiffleLowerV2.lowerRank (RiffleLowerV2.prefixAt l a) omega +\n                    RiffleLowerV2.relativeLowerCount a l m x omega ∧\n                RiffleLowerV2.upperRank (RiffleLowerV2.prefixAt m w) omega =\n                  RiffleLowerV2.lowerRank (RiffleLowerV2.prefixAt l a) omega +\n                    RiffleLowerV2.relativeUpperCount a l m x omega","type_dependencies":["Nat","TimeProfile.Cuts","LE.le","instLENat","RiffleLowerV2.Word","RiffleLowerV2.WordOn","RiffleLowerV2.columnSet","Eq","List","Fin","List.take","List.Vector.toList","RiffleLowerV2.restrictWord","RiffleLowerV2.Sample","And","RiffleLowerV2.lowerRank","RiffleLowerV2.prefixAt","HAdd.hAdd","instHAdd","instAddNat","RiffleLowerV2.relativeLowerCount","RiffleLowerV2.upperRank","RiffleLowerV2.relativeUpperCount"],"value":"","value_dependencies":["Nat","TimeProfile.Cuts","LE.le","instLENat","RiffleLowerV2.Word","RiffleLowerV2.WordOn","RiffleLowerV2.columnSet","Eq","List","Fin","List.take","List.Vector.toList","RiffleLowerV2.restrictWord","RiffleLowerV2.Sample","Finset","Finset.filter","LT.lt","List.instLT","instLTFin","RiffleLowerV2.rowWord","List.decidableLT","instDecidableEqFin","Fin.decLt","Finset.univ","Fin.fintype","And","RiffleLowerV2.wordOnList","instDecidableAnd","instDecidableEqList","List.LE'","Fin.instLinearOrder","Classical.propDecidable","Membership.mem","Set