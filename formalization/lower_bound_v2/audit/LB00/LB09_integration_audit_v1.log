DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"RiffleLowerV2.Localization.prefix_rank_bounds_of_take_eq","type":"∀ {k N K l m : ℕ} {cuts : TimeProfile.Cuts k N K},\n  l ≤ m →\n    m ≤ K →\n      ∀ (a w : RiffleLowerV2.Word k K),\n        List.take l (List.Vector.toList w) = List.take l (List.Vector.toList a) →\n          ∀ (omega : RiffleLowerV2.Sample cuts),\n            RiffleLowerV2.lowerRank (RiffleLowerV2.prefixAt l a) omega ≤\n                RiffleLowerV2.lowerRank (RiffleLowerV2.prefixAt m w) omega ∧\n              RiffleLowerV2.upperRank (RiffleLowerV2.prefixAt m w) omega ≤\n                RiffleLowerV2.upperRank (RiffleLowerV2.prefixAt l a) omega","type_dependencies":["Nat","TimeProfile.Cuts","LE.le","instLENat","RiffleLowerV2.Word","Eq","List","Fin","List.take","List.Vector.toList","RiffleLowerV2.Sample","And","RiffleLowerV2.lowerRank","RiffleLowerV2.prefixAt","RiffleLowerV2.upperRank"],"value":"","value_dependencies":["Nat","TimeProfile.Cuts","LE.le","instLENat","RiffleLowerV2.Word","Eq","List","Fin","List.take","List.Vector.toList","RiffleLowerV2.Sample","Eq.mpr","And","RiffleLowerV2.lowerRank","RiffleLowerV2.prefixAt","RiffleLowerV2.upperRank","Finset.card","Finset.filter","LT.lt","List.instLT","instLTFin","RiffleLowerV2.rowWord","List.decidableLT","instDecidableEqFin","Fin.decLt","Finset.univ","Fin.fintype","id","congrArg","RiffleLowerV2.Localization.lowerRank_prefixAt","LE.le.trans","Nat.instPreorder","List.LE'","Fin.instLinearOrder","Classical.propDecidable","RiffleLowerV2.Localization.upperRank_prefixAt","And.intro","Finset.card_le_card","Membership.mem","Finset","SetLike.instMembership","Finset.instSetLike","Iff.mpr","Finset.mem_filter","Finset.mem_univ","Or","RiffleLowerV2.wordOnList","RiffleLowerV2.columnSet","RiffleLowerV2.restrictWord","RiffleLowerV2.Localization.take_lt_split","Or.inl","And.right","Iff.mp","Or.casesOn","RiffleLowerV2.Localization.take_le_split","Eq.mp","Preorder.toLE","Partial