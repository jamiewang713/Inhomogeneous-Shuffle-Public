COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.HypergeomParams.weight_sum","type":"∀ (p : RiffleLowerV2.Thinning.Compat.HypergeomParams), ∑ q, p.weight q = 1"}
COMPAT_DECLARATION_JSON {"axioms":[],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.HypergeomParams.mk.congr_simp","type":"∀ (population population_1 : ℕ) (e_population : population = population_1) (marked marked_1 : ℕ)\n  (e_marked : marked = marked_1) (draws draws_1 : ℕ) (e_draws : draws = draws_1) (marked_le : marked ≤ population)\n  (draws_le : draws ≤ population),\n  { population := population, marked := marked, draws := draws, marked_le := marked_le, draws_le := draws_le } =\n    { population := population_1, marked := marked_1, draws := draws_1, marked_le := ⋯, draws_le := ⋯ }"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.residualSampleEquiv._proof_8","type":"∀ {α : Type u_1} [inst : DecidableEq α] (V R B : Finset α) (m : ℕ) (hR : R ⊆ V) (hB : B ⊆ R) (hBm : B.card ≤ m)\n  (S : { S // ↑S ∩ R = B }), ⟨⟨B ∪ ↑⟨↑↑S \\ R, ⋯⟩, ⋯⟩, ⋯⟩ = S"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.HypergeomParams.varianceFormula.eq_1","type":"∀ (p : RiffleLowerV2.Thinning.Compat.HypergeomParams),\n  p.varianceFormula =\n    ↑p.marked * ↑p.draws * (↑p.population - ↑p.marked) * (↑p.population - ↑p.draws) /\n      (↑p.population ^ 2 * (↑p.population - 1))"}
COMPAT_DECLARATION_JSON {"axioms":[],"is_theorem":true,"name":"_private.RiffleLowerV2.Thinning.Compat.HypergeometricConcentration.0.RiffleLowerV2.Thinning.Compat.HypergeomParams.swapped.eq_1","type":"∀ (p : RiffleLowerV2.Thinning.Compat.HypergeomParams),\n  RiffleLowerV2.Thinning.Compat.HypergeomParams.swapped✝ p =\n    { population := p.population, marked := p.draws, draws := p.marked, marked_le := ⋯, draws_le := ⋯ }"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.FiniteLaw.toPMF._proof_1","type":"∀ {Ω : Type u_1} [inst : Fintype Ω] (p : RiffleLowerV2.Thinning.Compat.FiniteLaw Ω), ∑ a, ENNReal.ofReal (p.mass a) = 1"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.HypergeomParams.weight_sum._simp_1_2","type":"∀ {ι : Type u_1} {K : Type u_2} [inst : DivisionSemiring K] (s : Finset ι) (f : ι → K) (a : K),\n  ∑ i ∈ s, f i / a = (∑ i ∈ s, f i) / a"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.FiniteLaw.prob.eq_1","type":"∀ {Ω : Type u_1} [inst : Fintype Ω] (p : RiffleLowerV2.Thinning.Compat.FiniteLaw Ω) (E : Ω → Prop),\n  p.prob E = ∑ ω, if E ω then p.mass ω else 0"}
