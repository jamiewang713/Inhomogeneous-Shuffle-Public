COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"_private.RiffleLowerV2.Thinning.Compat.HypergeometricConcentration.0.RiffleLowerV2.Thinning.Compat.HypergeomParams.extendedWeight.eq_1","type":"∀ (p : RiffleLowerV2.Thinning.Compat.HypergeomParams) (q : ℕ),\n  RiffleLowerV2.Thinning.Compat.HypergeomParams.extendedWeight✝ p q =\n    if q ≤ p.draws then\n      ↑(p.marked.choose q) * ↑((p.population - p.marked).choose (p.draws - q)) / ↑(p.population.choose p.draws)\n    else 0"}
