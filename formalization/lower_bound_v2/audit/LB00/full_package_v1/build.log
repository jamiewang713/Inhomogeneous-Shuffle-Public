  (A : I → Finset (Fin N)) (hA : ∀ (i j : I), i ≠ j → Disjoint (A i) (A j))
  (F : ((i : I) → Equiv.Perm (Fin (A i).card)) → ℝ) :
  (RiffleLowerV2.expect (RiffleLowerV2.uniformPermutation N) fun π =>
      F fun i => RiffleLowerV2.Ascent.relativeOrder (A i) π) =
    RiffleLowerV2.expect (PMF.uniformOfFintype ((i : I) → Equiv.Perm (Fin (A i).card))) F
RiffleLowerV2.Ascent.expect_prod_of_relativeOrder.{u_1} {N : ℕ} {I : Type u_1} [Fintype I] [DecidableEq I]
  (A : I → Finset (Fin N)) (hA : ∀ (i j : I), i ≠ j → Disjoint (A i) (A j)) (f : I → RiffleLowerV2.Permutation N → ℝ)
  (hf : ∀ (i : I) (π σ : RiffleLowerV2.Permutation N), (∀ x ∈ A i, ∀ y ∈ A i, π x < π y ↔ σ x < σ y) → f i π = f i σ) :
