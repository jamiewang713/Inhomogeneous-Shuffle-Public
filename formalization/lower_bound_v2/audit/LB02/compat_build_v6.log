COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.FiniteLaw.coarse_total_probability","type":"∀ {Ω : Type u_1} {Γ : Type u_2} {Δ : Type u_3} [inst : Fintype Ω] [inst_1 : Fintype Γ] [Fintype Δ]\n  (p : RiffleLowerV2.Thinning.Compat.FiniteLaw Ω) (Z : Ω → Γ) (U : Ω → Δ) (g : Γ → Δ),\n  (∀ (ω : Ω), U ω = g (Z ω)) →\n    ∀ (u : Δ),\n      (0 < p.prob fun ω => U ω = u) →\n        ∀ (B : Ω → Prop),\n          p.conditionalProb (fun ω => U ω = u) B =\n            ∑ z, (p.conditionalProb (fun ω => U ω = u) fun ω => Z ω = z) * p.conditionalProb (fun ω => Z ω = z) B"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.intersection_fibre_card._proof_1_1","type":"∀ {α : Type u_1} [inst : DecidableEq α] (A : Finset α) (m q : ℕ),\n  q ≤ m → ∀ ⦃S : Finset α⦄, (A ∩ S).card = q → S.card = m → (S \\ A).card + q = m → ¬(S \\ A).card = m - q → False"}
COMPAT_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_theorem":true,"name":"RiffleLowerV2.Thinning.Compat.FiniteLaw.coarse_total_probability_bound","type":"∀ {Ω : Type u_1} {Γ : Type u_2} {Δ : Type u_3} [inst : Fintype Ω] [inst_1 : Fintype Γ] [Fintype Δ]\n  (p : RiffleLowerV2.Thinning.Compat.FiniteLaw Ω) (Z : Ω → Γ) (U : Ω → Δ) (g : Γ → Δ),\n  (∀ (ω : Ω), U ω = g (Z ω)) →\n    ∀ (u : Δ),\n      (0 < p.prob fun ω => U ω = u) →\n        ∀ (B : Ω → Prop) (b : Γ → ℝ),\n          (∀ (z : Γ), (0 < p.prob fun ω => Z ω = z) → p.conditionalProb (fun ω => Z ω = z) B ≤ b z) →\n            p.conditionalProb (fun ω => U ω = u) B ≤ ∑ z, (p.conditionalProb (fun ω => U ω = u) fun ω => Z ω = z) * b z"}
