RiffleLowerV2.Ascent.conditionalLalleyTest (a δ D ε : ℝ) (ha : 0 < a) (hδ : 0 < δ) (hD : 0 ≤ D) (hε : 0 < ε) :
  ∃ (N0 : ℕ),
    1 ≤ N0 ∧
      ∀ N ≥ N0,
        ∀ (H0 : Finset ℤ) (ρ : PMF (RiffleLowerV2.PathEdges N)) (P : PMF (RiffleLowerV2.Permutation N)),
          P = RiffleLowerV2.Ascent.pathGraphMixture ρ →
            ↑N ^ a ≤ ↑H0.card →
              (∀ (q : Fin (N + 1)),
                  ↑(RiffleLowerV2.boundary (RiffleLowerV2.clipTranslate N H0 ↑↑q)).card ≤ D * √↑H0.card) →
                RiffleLowerV2.probability ρ (RiffleLowerV2.Ascent.graphScanSuccess H0 δ) - ε ≤
                  RiffleLowerV2.tv P (RiffleLowerV2.uniformPermutation N)
RiffleLowerV2.Ascent.conditionalLalleyTendsto (a δ D : ℝ) (ha : 0 < a) (hδ : 0 < δ) (hD : 0 ≤ D) (H0 : ℕ → Finset ℤ)
  (ρ : (N : ℕ) → PMF (RiffleLowerV2.PathEdges N)) (P : (N : ℕ) → PMF (RiffleLowerV2.Permutation N))
  (hP : ∀ (N : ℕ), P N = RiffleLowerV2.Ascent.pathGraphMixture (ρ N))
  (hgeometry :
    ∀ᶠ (N : ℕ) in Filter.atTop,
      ↑N ^ a ≤ ↑(H0 N).card ∧
        ∀ (q : Fin (N + 1)),
          ↑(RiffleLowerV2.boundary (RiffleLowerV2.clipTranslate N (H0 N) ↑↑q)).card ≤ D * √↑(H0 N).card)
  (hgood :
    Filter.Tendsto (fun (N : ℕ) => RiffleLowerV2.probability (ρ N) (RiffleLowerV2.Ascent.graphScanSuccess (H0 N) δ))
      Filter.atTop (nhds 1)) :
  Filter.Tendsto (fun (N : ℕ) => RiffleLowerV2.tv (P N) (RiffleLowerV2.uniformPermutation N)) Filter.atTop (nhds 1)
