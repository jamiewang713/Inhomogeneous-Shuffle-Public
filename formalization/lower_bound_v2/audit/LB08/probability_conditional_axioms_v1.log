LB08_CONDITIONAL_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"name":"RiffleLowerV2.Occupancy.logScale_le_two_logScale_sub","type":"∀ {N b : ℕ}, 2 ≤ N - b → ↑N ≤ 2 * ↑(N - b) → TimeProfile.logScale N ≤ 2 * TimeProfile.logScale (N - b)"}
LB08_CONDITIONAL_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"name":"RiffleLowerV2.Occupancy.tau_sub_le_two_tau","type":"∀ {N b : ℕ}, 0 < N → ↑N ≤ 2 * ↑(N - b) → RiffleLowerV2.Occupancy.tau (N - b) ≤ 2 * RiffleLowerV2.Occupancy.tau N"}
LB08_CONDITIONAL_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"name":"RiffleLowerV2.Occupancy.eventual_residual_budgets","type":"∀ (c C D : ℝ),\n  0 < c →\n    ∀ (b0 M0 : ℕ),\n      ∃ (N0 : ℕ),\n        b0 < N0 ∧\n          2 ≤ N0 ∧\n            ∀ N ≥ N0,\n              ∀ b ≤ b0,\n                b < N ∧\n                  2 ≤ N - b ∧\n                    M0 ≤ N - b ∧\n                      2 * ↑b ≤ c * ↑N ∧\n                        ↑N ≤ 2 * ↑(N - b) ∧\n                          TimeProfile.logScale N ≤ 2 * TimeProfile.logScale (N - b) ∧\n                            RiffleLowerV2.Occupancy.tau (N - b) ≤ 2 * RiffleLowerV2.Occupancy.tau N ∧\n                              RiffleLowerV2.Occupancy.tau N ≤ 1 / 2 ∧\n                                D * (C * TimeProfile.logScale N + 1) * ↑b0 / ↑N ≤ RiffleLowerV2.Occupancy.tau N"}
LB08_CONDITIONAL_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"name":"RiffleLowerV2.Occupancy.residual_selected_piles","type":"∀ {N k K b : ℕ} (cuts : TimeProfile.Cuts k N K) (p : RiffleLowerV2.RowPrescription N k K b) (w : RiffleLowerV2.Word k K)\n  (residual : TimeProfile.Cuts k (N - b) K),\n  (∀ (j : Fin K) (a : Fin k), residual.count j a = cuts.count j a - RiffleLowerV2.usedCount p j a) →\n    ∀ {c : ℝ},\n      0 < c →\n        2 * ↑b ≤ c * ↑N →\n          (∀ (j : Fin K), c * ↑N ≤ ↑(cuts.count j (List.Vector.get w j))) →\n            ∀ (j : Fin K), c / 2 * ↑(N - b) ≤ ↑(residual.count j (List.Vector.get w j))"}
LB08_CONDITIONAL_DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"name":"RiffleLowerV2.Occupancy.conditionalCollisionStability","type":"RiffleLowerV2.Targets.ConditionalCollisionStability"}
