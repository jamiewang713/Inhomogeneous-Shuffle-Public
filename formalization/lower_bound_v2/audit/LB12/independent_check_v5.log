TimeProfile.Cuts k (N - b) K),\n          (∀ (j : Fin K) (a : Fin k), residual.count j a = cuts.count j a - RiffleLowerV2.usedCount p j a) ∧\n            (∀ (w : RiffleLowerV2.Word k K) (F : ℕ → ℝ),\n                RiffleLowerV2.conditionalExpect (TimeProfile.fixedCountPMF cuts)\n                    (fun (ω : TimeProfile.ShuffleSample cuts) =>\n                      F (RiffleLowerV2.wordCount w ω - {q : Fin b | p.word q = w}.card))\n                    (RiffleLowerV2.prescriptionEvent p) =\n                  RiffleLowerV2.expect (TimeProfile.fixedCountPMF residual)\n                    fun (η : TimeProfile.ShuffleSample residual) => F (RiffleLowerV2.wordCount w η)) ∧\n              (∀ (w : RiffleLowerV2.Word k K) (A : ℕ → Prop),\n                  RiffleLowerV2.conditionalProbability (TimeProfile.fixedCountPMF cuts)\n                      (fun (ω : TimeProfile.ShuffleSample cuts) =>\n                        A (RiffleLowerV2.wordCount w ω - {q : Fin b | p.word q = w}.card))\n                      (RiffleLowerV2.prescriptionEvent p) =\n                    RiffleLowerV2.probability (TimeProfile.fixedCountPMF residual)\n                      fun (η : TimeProfile.ShuffleSample residual) => A (RiffleLowerV2.wordCount w η)) ∧\n                ∀ (w : RiffleLowerV2.Word k K),\n                  ↑(N - b) * RiffleLowerV2.wordMass residual w = RiffleLowerV2.Targets.residualWordMean cuts p w","type_dependencies":["Nat","TimeProfile.Cuts","RiffleLowerV2.RowPrescription","LT.lt","instLTNat","Function.Injective","Fin","RiffleLowerV2.RowPrescription.row","Real","Real.instLT","OfNat.ofNat","Zero.toOfNat0","Real.instZero","RiffleLowerV2.probability","TimeProfile.ShuffleSample","TimeProfile.instFintypeShuffleSample","TimeProfile.fixedCountPMF","RiffleLowerV2.prescriptionEvent","Exists","HSub.hSub","instHSub","instSubNat","And","Eq","TimeProfile.Cuts.count","RiffleLowerV2.usedCount","RiffleLowerV2.Word","RiffleLowerV2.conditionalExpect","RiffleLowerV2.wordCount","Finset.card","Finset.f