  RiffleUpperV2.EmpiricalNegativeMargin N a cuts hn eta →
    a ≤ s →
      s ≤ u →
        u ≤ a + L →
          0 ≤ q →
            0 ≤ S →
              S ≤ V - F + q →
                V - q ≤ 2 * F →
                  V ≤ RiffleUpperV2.empiricalBeta N a cuts hn s →
                    ell ≤ 2 * delta →
                      (∀ theta ∈ Set.Icc 3 4, H ≤ theta * S - RiffleUpperV2.empiricalB N a cuts hn theta s u + eH) →
                        E = -RiffleUpperV2.empiricalB N a cuts hn 2 u (a + L) →
                          H + 4 * ell + 2 * E ≤ -eta + 8 * delta + 21 * q / 2 + eH :=
