 : 2 ≤ N) (D B : ℕ),\n      2 ≤ B →\n        ∀ (g ξ η A r γ : ℝ),\n          0 < g →\n            0 < r →\n              0 ≤ γ →\n                RiffleUpperV2.Exploration.retainedGoodCluster cuts ⋯ D g →\n                  RiffleLowerV2.maximalMean cuts ⋯ ≤ ↑N ^ (-η) →\n                    A + 1 ≤ η * ↑B →\n                      (RiffleUpperV2.probability (RiffleUpperV2.fixedCountPMF cuts)\n                            fun (ω : TimeProfile.ShuffleSample cuts) =>\n                            ¬RiffleUpperV2.Exploration.concentrationEvent cuts D g ξ ω) ≤\n                          r →\n                        (∀ (p : Fin k) (d : RiffleUpperV2.Exploration.Direction),\n                            ↑N ^ ξ ≤ ↑(RiffleUpperV2.Exploration.pileSize cuts p) →\n                              ∀ i ≤ RiffleUpperV2.Exploration.pileSize cuts p,\n                                ∀ (ω : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts),\n                                  (0 <\n                                      RiffleUpperV2.probability (RiffleUpperV2.independentPairLaw cuts)\n                                        fun (v : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts) =>\n                                        RiffleUpperV2.Exploration.pairHistory cuts p d i v =\n                                          RiffleUpperV2.Exploration.pairHistory cuts p d i ω) →\n                                    RiffleUpperV2.Exploration.pairHistoryGood cuts D g ξ (√r) p d i ω →\n                                      (RiffleUpperV2.conditionalExpect (RiffleUpperV2.independentPairLaw cuts)\n                                          (fun (v : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts) =>\n                                            ↑(RiffleUpperV2.Exploration.remainingDirectionalCount cuts D g ξ p d i v.1\n                                                v.2))\n                                          fun (v : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts) =>\n         