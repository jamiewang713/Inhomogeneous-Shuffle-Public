RiffleUpperV2.FirstMoment.classEntropy.{u_1} {J : Type u_1} [Fintype J] [DecidableEq J] {k N : ℕ} (hk : 2 ≤ k)
  (hN : 2 ≤ N) (p : J → TimeProfile.Simplex k) (I : Finset J) (chi width theta : ℝ) (hwidth : 0 < width)
