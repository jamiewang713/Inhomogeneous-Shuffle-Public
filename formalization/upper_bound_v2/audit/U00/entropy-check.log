RiffleUpperV2.FirstMoment.classEntropy_of_exceptionalBudget.{u_1} {J : Type u_1} [Fintype J] [DecidableEq J] {k N : ℕ}
  (hk : 2 ≤ k) (hN : 2 ≤ N) (p : J → TimeProfile.Simplex k) (I : Finset J) (chi width theta alpha : ℝ)
  (hwidth : 0 < width) (htheta : theta ∈ Set.Icc 3 4) (w0 : J → Fin k)
  (hlegal : ∀ j ∈ I, 0 < TimeProfile.prob (p j) (w0 j))
  (hbudget : ↑(RiffleUpperV2.FirstMoment.exceptionalPositions p I chi w0).card ≤ alpha * TimeProfile.logScale N) :
