RiffleUpperV2.FirstMoment.empiricalClassEntropy {k n L N : ℕ} (hk : 2 ≤ k) (hN : 2 ≤ N) (a s u : ℕ)
  (cuts : RiffleUpperV2.Cuts k n L) (hn : 0 < n) (chi width theta alpha : ℝ) (hwidth : 0 < width)
  (htheta : theta ∈ Set.Icc 3 4) (w0 : Fin L → Fin k)
  (hlegal :
    ∀ j ∈ RiffleUpperV2.FirstMoment.empiricalPositions L a s u,
      0 < TimeProfile.prob (TimeProfile.Cuts.profile cuts hn j) (w0 j))
  (hbudget :
    ↑(RiffleUpperV2.FirstMoment.exceptionalPositions (TimeProfile.Cuts.profile cuts hn)
            (RiffleUpperV2.FirstMoment.empiricalPositions L a s u) chi w0).card ≤
      alpha * TimeProfile.logScale N) :
  Real.log
        ↑(RiffleUpperV2.FirstMoment.costClass N (TimeProfile.Cuts.profile cuts hn)
              (RiffleUpperV2.FirstMoment.empiricalPositions L a s u) chi width w0).card /
      TimeProfile.logScale N ≤
    theta *
          RiffleUpperV2.FirstMoment.goodCost N (TimeProfile.Cuts.profile cuts hn)
            (RiffleUpperV2.FirstMoment.empiricalPositions L a s u) chi w0 -
        RiffleUpperV2.empiricalB N a cuts hn theta s u +
      (4 * width + 4 * Real.log ↑k * alpha)
'RiffleUpperV2.FirstMoment.empiricalClassEntropy' depends on axioms: [propext, Classical.choice, Quot.sound]
