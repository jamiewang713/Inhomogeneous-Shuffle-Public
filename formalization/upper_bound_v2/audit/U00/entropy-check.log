    theta * RiffleUpperV2.FirstMoment.goodCost N p I chi w0 -
        (∑ j ∈ I, TimeProfile.psi (p j) theta) / TimeProfile.logScale N +
      (4 * width + 4 * Real.log ↑k * alpha)
