L + 1) ≤ T * Real.log ↑n →\n                                    ∀ (cuts : RiffleUpperV2.Cuts k n (L + 1)) (hn : 0 < n),\n                                      TimeProfile.GoodColumn (TimeProfile.Cuts.profile cuts hn 0) g →\n                                        ∀ (xi eta epsilon : ℝ),\n                                          0 ≤ epsilon →\n                                            ∀ (p : Fin k) (d : RiffleUpperV2.Exploration.Direction)\n                                              (omega : RiffleUpperV2.Sample cuts)\n                                              (j : Fin (RiffleUpperV2.Exploration.pileSize cuts p)),\n                                              RiffleUpperV2.Exploration.positiveHistory cuts p d (↑j + 1) omega →\n                                                RiffleUpperV2.Exploration.historyGood cuts D g xi epsilon p d (↑j + 1)\n                                                    omega →\n                                                  RiffleUpperV2.Exploration.hasDirection cuts D g d\n                                                      (RiffleUpperV2.sortedWord omega\n                                                        (RiffleUpperV2.Exploration.pilePosition cuts p d j)) →\n                                                    ∀ (x : RiffleUpperV2.Prefix k (L + 1)),\n                                                      0 < ↑x.fst →\n                                                        (∀ (w : RiffleUpperV2.Word k (L + 1)),\n                                                            RiffleUpperV2.Conditional.inCylinder x w →\n                                                              List.Vector.get w 0 = p) →\n                                                          (∀ (w : RiffleUpperV2.Word k (L + 1)),\n                                                              RiffleUpperV2.Conditional.inCylinder x w →\n                                                                match d with\n                                                                | RiffleUpperV2.Exploration.Direction.forward =>\n                                                                  RiffleUpperV2.sortedWord omega\n                                                                      (RiffleUpperV2.Exploration.pilePosition cuts p d\n                                                                        j) <\n                                                                    w\n                                                                | RiffleUpperV2.Exploration.Direction.backward =>\n                                                                  w <\n                                                                    RiffleUpperV2.sortedWord omega\n                                                                      (RiffleUpperV2.Exploration.pilePosition cuts p d\n                                                                        j)) →\n                                                            ↑n ^ (-xi) ≤ RiffleUpperV2.prefixMean cuts x →\n                                                              RiffleUpperV2.prefixMean cuts x ≤ ↑n ^ xi →\n                                                                RiffleUpperV2.empiricalBeta n 0 cuts hn (L + 1) ≤ -eta →\n                                                                  RiffleUpperV2.conditionalExpect\n                                                                      (RiffleUpperV2.fixedCountPMF cuts)\n                                                                      (fun (z : TimeProfile.ShuffleSample cuts) =>\n                                                                        ∑ w : RiffleUpperV2.Word k (L + 1),\n                                                                          if\n                                                                              RiffleUpperV2.Conditional.inCylinder x\n                                                                                w then\n                                                                            ↑((RiffleUpperV2.Reservoir.wordCount z\n                                                                                    w).choose\n                                                                                2)\n                                                                          else 0)\n                                                                      (RiffleUpperV2.Exploration.historyFiber cuts p d\n                                                                        (↑j + 1) omega) ≤\n                                                                    C2 *\n                                                                        ↑n ^\n                                                                          (-eta + 3 * xi +\n                                                                            2 *\n                                                                                (Real.log (1 / g) /\n                                                                                  Real.log (1 / tau)) *\n                                                                              (1 + eta - 2 * xi)) +\n                                                                      ↑n ^ 2 * epsilon"}
