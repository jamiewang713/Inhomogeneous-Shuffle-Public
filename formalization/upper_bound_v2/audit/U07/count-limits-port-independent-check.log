RiffleUpperV2.Compat.profileCount_uniform_eventually (k d : ℕ) (T a b tb te : ℝ) (hT : 0 ≤ T) (ha : 0 ≤ a) (hb : 0 ≤ b)
  (htb : 0 < tb) (htb1 : tb ≤ 1) (hte : 0 < te) (hte1 : te ≤ 1) (eps : ℝ) (heps : 0 < eps) :
  ∃ N0,
    2 ≤ N0 ∧
      ∀ (N K qb qe : ℕ),
        N0 ≤ N →
          ↑K ≤ T * Real.log ↑N →
            ↑qb ≤ a * Real.log ↑N →
              ↑qe ≤ b * Real.log ↑N →
                ↑(InhomogeneousShuffle.FirstMoment.profileCountBound K k qb qe d) ≤
                  ↑N ^ (2 * a * Real.log (1 / tb) + b * Real.log (1 / te) + ↑k * T * (2 * tb + te) + eps)
RiffleUpperV2.Compat.profileCount_small_chi (k : ℕ) (T C eps : ℝ) (hk : 2 ≤ k) (hT : 0 ≤ T) (hC : 0 < C)
  (heps : 0 < eps) :
  ∃ chi0,
    0 < chi0 ∧
      chi0 < min 1 (1 / ↑k) ∧
        ∀ (chi : ℝ),
          0 < chi →
            chi < chi0 →
              ∀ (d : ℕ),
                ∃ N0,
                  2 ≤ N0 ∧
                    ∀ (N K : ℕ),
                      N0 ≤ N →
                        ↑K ≤ T * Real.log ↑N →
                          ↑(InhomogeneousShuffle.FirstMoment.profileCountBound K k
                                ⌊C / Real.log (1 / chi) * Real.log ↑N⌋₊
                                ⌊TimeProfile.exceptionalAllowance chi * Real.log ↑N⌋₊ d) ≤
                            ↑N ^ eps
'RiffleUpperV2.Compat.profileCount_uniform_eventually' depends on axioms: [propext, Classical.choice, Quot.sound]
'RiffleUpperV2.Compat.profileCount_small_chi' depends on axioms: [propext, Classical.choice, Quot.sound]
BUILD_OK U07
