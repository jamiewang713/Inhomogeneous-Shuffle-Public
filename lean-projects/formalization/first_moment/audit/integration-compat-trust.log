  ∫ (sample : TimeProfile.ShuffleSample cuts),
      ↑(TimeProfile.boxRows A sample).card ∂TimeProfile.fixedCountMeasure cuts =
    ↑N * ∏ j, ∑ l ∈ A j, TimeProfile.prob (cuts.profile hN j) l
TimeProfile.expected_prefix_count {k N K : ℕ} (cuts : TimeProfile.Cuts k N K) (hN : 0 < N) (x : Fin K → Fin k) (M : ℕ)
  (hMK : M ≤ K) :
  ∫ (sample : TimeProfile.ShuffleSample cuts),
      ↑(TimeProfile.prefixRows x M sample).card ∂TimeProfile.fixedCountMeasure cuts =
    TimeProfile.prefixMass N (cuts.profile hN) x M
