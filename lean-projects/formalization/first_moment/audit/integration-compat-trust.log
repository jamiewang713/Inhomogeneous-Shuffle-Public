Riffle.gamma_first_crossing {D : Riffle.Model} {A : Riffle.Setup D} {y z x : Riffle.Word} (hp : Riffle.RawPair A y z)
  (hroot : ¬Riffle.Stop A y z (Riffle.join y z)) (hx : x ∈ Riffle.Gamma A y z) :
  List.length (Riffle.join y z) < List.length x ∧
    Riffle.parent x ∈ Riffle.Desc D A.w ∧
      ¬Riffle.Stop A y z (Riffle.parent x) ∧
        ∀ u ∈ Riffle.Desc D (Riffle.join y z), u <+: Riffle.parent x → ¬Riffle.Stop A y z u
Riffle.pieceEvent_iff {D : Riffle.Model} {A : Riffle.Setup D} (s : Riffle.Side) {x ω : Riffle.Word} {i : ℕ}
  (hx : x ∈ Riffle.Desc D A.w) (_hiw : List.length A.w ≤ i) (hix : i < List.length x) :
  ω ∈ Riffle.PieceEvent A s x i ↔
    ω ∈ Riffle.Cylinder D A.w ∧
      List.take i ω = List.take i x ∧
        match s with
        | Riffle.Side.left => Riffle.digit ω i < Riffle.digit x i
        | Riffle.Side.right => Riffle.digit x i < Riffle.digit ω i
