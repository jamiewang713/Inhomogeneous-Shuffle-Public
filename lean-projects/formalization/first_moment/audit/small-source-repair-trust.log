@InhomogeneousShuffle.FirstMoment.Model.small_coarse_numerical_core : ∀
  {Lv F E H S beta Dtail theta eBeta eF eS eH eE : ℝ} {B : ℝ → ℝ},
  theta ∈ Set.Icc 3 4 →
    0 ≤ eBeta →
      0 ≤ eF →
        0 ≤ eS →
          0 ≤ eH →
            0 ≤ eE →
              0 ≤ S →
                S ≤ Lv - F + eS →
                  Lv / 2 - eF ≤ F →
                    Lv ≤ beta + eBeta →
                      H ≤ theta * S - B theta + eH →
                        E ≤ -Dtail + eE →
                          H + 2 * E ≤
                            TimeProfile.largeObjective beta B Dtail theta +
                              (7 / 2 * eBeta + 7 * eF + 7 * eS + eH + 2 * eE)
