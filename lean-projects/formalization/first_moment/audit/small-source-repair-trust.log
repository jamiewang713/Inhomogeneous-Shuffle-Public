@InhomogeneousShuffle.FirstMoment.Model.source_small_coarse_margin : ∀ {k N R : ℕ}
  {T rho phi chi C r b er eb eta alpha delta : ℝ} (cuts : TimeProfile.Cuts k N (TimeProfile.horizonDepth N T))
  (hN : 2 ≤ N),
  2 ≤ k →
    ∀ (mu : TimeProfile.TimeLaw k) (P : TimeProfile.BorelPartition k),
      0 ≤ T →
        0 < rho →
          0 ≤ phi →
            chi ∈ Set.Ioo 0 (1 / ↑k) →
              0 ≤ C →
                P.IsRegular chi C →
                  TimeProfile.AlmostLike cuts ⋯ mu P T rho phi →
                    0 ≤ r →
                      r ≤ T →
                        0 ≤ er →
                          0 ≤ eb →
                            0 < eta →
                              0 ≤ alpha →
                                0 ≤ delta →
                                  TimeProfile.FirstMomentMargin mu r b T eta →
                                    ∀ (x : Fin (TimeProfile.horizonDepth N T) → Fin k)
                                      (timeClass : Fin (TimeProfile.horizonDepth N T) → Fin R) {w v n : ℕ},
                                      w ≤ v →
                                        v ≤ n →
                                          n ≤ TimeProfile.horizonDepth N T →
                                            TimeProfile.LegalPrefix (cuts.profile ⋯) x n →
                                              TimeProfile.AmbientApproximation N (cuts.profile ⋯) x w r b er eb →
                                                TimeProfile.profileR N (cuts.profile ⋯) x P chi v n ≤ alpha →
                                                  TimeProfile.Crossings (cuts.profile ⋯) x w v chi →
                                                    (have A := 4 * Real.log ↑k;
                                                      have Qerr :=
                                                        TimeProfile.quadratureError N T rho phi P.cellCount A (C * chi);
                                                      7 / 2 * (Qerr + A * (er + 1 / TimeProfile.logScale N)) +
                                                                    7 *
                                                                      ((eb +
                                                                          Real.log (1 / chi) / TimeProfile.logScale N) /
                                                                        2) +
                                                                  7 *
                                                                    (C * chi * T +
                                                                      Real.log (1 / chi) / TimeProfile.logScale N) +
                                                                (Qerr + A * alpha) +
                                                              2 * Qerr +
                                                            8 * delta +
                                                          4 * eb ≤
                                                        3 * eta / 4) →
                                                      ∃ F,
                                                        TimeProfile.cF N (cuts.profile ⋯) x w v = ↑F ∧
                                                          (TimeProfile.ParentCrossing N (cuts.profile ⋯) x b w v n F
                                                              delta →
                                                            TimeProfile.profileH N (cuts.profile ⋯) x P timeClass chi v
                                                                      n +
                                                                    2 * TimeProfile.cE N (cuts.profile ⋯) n +
                                                                  8 * delta +
                                                                4 * eb ≤
                                                              -eta / 4)
