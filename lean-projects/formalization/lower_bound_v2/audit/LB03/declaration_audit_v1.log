Factorial.residualMeanComparison : Targets.ResidualMeanComparison
Factorial.bonferroniSandwich : Targets.BonferroniSandwich
Factorial.bonferroniProduct : Targets.BonferroniProduct
Factorial.centralComparison : Targets.CentralComparison
Factorial.centralComparisonOne : Targets.CentralComparisonOne
Factorial.rareSandwich : Targets.RareSandwich
