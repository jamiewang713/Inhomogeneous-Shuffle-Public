                                          ∀ (phi : ℝ),
                                            0 < phi →
                                              phi ≤ phi0 →
                                                ∀ (μ : TimeProfile.TimeLaw k),
                                                  RiffleLowerV2.ScalarIntegrable μ P T →
                                                    ∃ (N0 : ℕ),
                                                      2 ≤ N0 ∧
                                                        ∀ (N : ℕ) (hN : 2 ≤ N),
                                                          N0 ≤ N →
                                                            ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                                                              TimeProfile.AlmostLike cuts
                                                                  (RiffleLowerV2.Targets.deckPos hN) μ P T rho phi →
                                                                RiffleLowerV2.Targets.ProfileIntervalErrors T cuts
                                                                    (RiffleLowerV2.Targets.deckPos hN) μ
                                                                    (RiffleLowerV2.MacroscopicLower.transferAccuracy
                                                                      eta) ∧
                                                                  RiffleLowerV2.Targets.ProfileMarginErrors T cuts
                                                                    (RiffleLowerV2.Targets.deckPos hN) μ
                                                                    (RiffleLowerV2.MacroscopicLower.transferAccuracy
                                                                      eta)) =>
                                      Exists.intro phi0
                                        ⟨hphi0,
                                          fun (phi : ℝ) (hphi : 0 < phi) (hphiSmall : phi ≤ phi0) (chiGood gamma : ℝ)
                                            (hchiGood : 0 < chiGood) (hgamma : 0 < gamma) (epsilon : ℝ)
                                            (hepsilon : 0 < epsilon) (μ : TimeProfile.TimeLaw k)
                                            (hμ : RiffleLowerV2.ScalarIntegrable μ P T) =>
                                          Exists.casesOn (htransferPhi phi hphi hphiSmall μ hμ)
                                            fun (Nt : ℕ)
                                              (h :
                                                2 ≤ Nt ∧
                                                  ∀ (N : ℕ) (hN : 2 ≤ N),
                                                    Nt ≤ N →
                                                      ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                                                        TimeProfile.AlmostLike cuts (RiffleLowerV2.Targets.deckPos hN) μ
                                                            P T rho phi →
                                                          RiffleLowerV2.Targets.ProfileIntervalErrors T cuts
                                                              (RiffleLowerV2.Targets.deckPos hN) μ
                                                              (RiffleLowerV2.MacroscopicLower.transferAccuracy eta) ∧
                                                            RiffleLowerV2.Targets.ProfileMarginErrors T cuts
                                                              (RiffleLowerV2.Targets.deckPos hN) μ
                                                              (RiffleLowerV2.MacroscopicLower.transferAccuracy eta)) =>
                                            And.casesOn h
                                              fun (left : 2 ≤ Nt)
                                                (htransferN :
                                                  ∀ (N : ℕ) (hN : 2 ≤ N),
                                                    Nt ≤ N →
                                                      ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                                                        TimeProfile.AlmostLike cuts (RiffleLowerV2.Targets.deckPos hN) μ
                                                            P T rho phi →
                                                          RiffleLowerV2.Targets.ProfileIntervalErrors T cuts
                                                              (RiffleLowerV2.Targets.deckPos hN) μ
                                                              (RiffleLowerV2.MacroscopicLower.transferAccuracy eta) ∧
                                                            RiffleLowerV2.Targets.ProfileMarginErrors T cuts
                                                              (RiffleLowerV2.Targets.deckPos hN) μ
                                                              (RiffleLowerV2.MacroscopicLower.transferAccuracy eta)) =>
                                              have hparams :=
                                                ⟨hchiGood,
                                                  ⟨hgamma,
                                                    ⟨hrho, hceiling.right rho (LE.le.trans hrhoSmall hrhoCeiling)⟩⟩⟩;
                                              Exists.casesOn
                                                (RiffleLowerV2.EmpiricalLower.largestOnly k hk T
                                                  (RiffleLowerV2.kappa0 (eta / 2)) hT hk0.left epsilon hepsilon)
                                                fun (Nl : ℕ)
                                                  (h :
                                                    2 ≤ Nl ∧
                                                      ∀ (N : ℕ) (hN : 2 ≤ N),
                                                        Nl ≤ N →
                                                          ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                                                            RiffleLowerV2.kappa0 (eta / 2) ≤
                                                                RiffleLowerV2.beta cuts
                                                                  (RiffleLowerV2.Targets.deckPos hN)
                                                                  (RiffleLowerV2.horizon N
                                                                    (TimeProfile.horizonDepth N T)) →
                                                              1 - epsilon ≤
                                                                RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                                                                  (RiffleLowerV2.uniformPermutation N)) =>
                                                And.casesOn h
                                                  fun (hNl : 2 ≤ Nl)
                                                    (hlargest :
                                                      ∀ (N : ℕ) (hN : 2 ≤ N),
                                                        Nl ≤ N →
                                                          ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                                                            RiffleLowerV2.kappa0 (eta / 2) ≤
                                                                RiffleLowerV2.beta cuts
                                                                  (RiffleLowerV2.Targets.deckPos hN)
                                                                  (RiffleLowerV2.horizon N
                                                                    (TimeProfile.horizonDepth N T)) →
                                                              1 - epsilon ≤
                                                                RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                                                                  (RiffleLowerV2.uniformPermutation N)) =>
                                                  Exists.casesOn
                                                    (RiffleLowerV2.EmpiricalLower.coldOnly k hk T (eta / 2) hT
                                                      (div_pos heta
                                                        (Mathlib.Meta.Positivity.pos_of_isNat
                                                          (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2))
                                                          (Eq.refl (Nat.ble 1 2))))
                                                      chiGood gamma rho hparams epsilon hepsilon)
                                                    fun (Nc : ℕ) (h : 2 ≤ Nc ∧ ∀ (N : ℕ) (hN : 2 ≤ N), Nc ≤ N → ⋯) =>
                                                    And.casesOn h
                                                      fun (left_1 : 2 ≤ Nc) (hcold : ∀ (N : ℕ) (hN : 2 ≤ N), ⋯) =>
                                                      let Nd :=
                                                        RiffleLowerV2.ProfileTransfer.transferThreshold (Real.log ↑k)
                                                          (RiffleLowerV2.MacroscopicLower.transferAccuracy eta);
                                                      Exists.intro (max Nt (max Nd (max Nl Nc))) ⋯⟩⟩⟩⟩⟩⟩
def RiffleLowerV2.Targets.EmpiricalCombinedTarget : Prop :=
∀ (k : ℕ),
  2 ≤ k →
    ∀ (T etaLargest etaCold : ℝ),
      0 < T →
        0 < etaLargest →
          0 < etaCold →
            ∀ (chiGood gamma rho epsilon : ℝ),
              0 < epsilon →
                ∃ (N0 : ℕ),
                  2 ≤ N0 ∧
                    ∀ (N : ℕ) (hN : 2 ≤ N),
                      N0 ≤ N →
                        ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                          RiffleLowerV2.Targets.EmpiricalAlternative T cuts ⋯ etaLargest etaCold chiGood gamma rho →
                            1 - epsilon ≤
                              RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                                (RiffleLowerV2.uniformPermutation N)
def RiffleLowerV2.Targets.MacroscopicIntegrableTarget : Prop :=
∀ (k : ℕ),
  2 ≤ k →
    ∀ (T eta : ℝ),
      0 < T →
        0 < eta →
          ∃ (chiPartition : ℝ),
            0 < chiPartition ∧
              chiPartition < 1 / ↑k ∧
                ∃ (P : TimeProfile.BorelPartition k),
                  P.IsRegular chiPartition 1 ∧
                    ∃ (rho0 : ℝ),
                      0 < rho0 ∧
                        2 * rho0 * Real.log ↑k ≤ RiffleLowerV2.kappa0 (eta / 2) / 100 ∧
                          ∀ (rho : ℝ),
                            0 < rho →
                              rho ≤ rho0 →
                                ∃ (phi0 : ℝ),
                                  0 < phi0 ∧
                                    ∀ (phi : ℝ),
                                      0 < phi →
                                        phi ≤ phi0 →
                                          ∀ (chiGood gamma : ℝ),
                                            0 < chiGood →
                                              0 < gamma →
                                                ∀ (epsilon : ℝ),
                                                  0 < epsilon →
                                                    ∀ (μ : TimeProfile.TimeLaw k),
                                                      RiffleLowerV2.ScalarIntegrable μ P T →
                                                        ∃ (N0 : ℕ),
                                                          2 ≤ N0 ∧
                                                            ∀ (N : ℕ) (hN : 2 ≤ N),
                                                              N0 ≤ N →
                                                                ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                                                                  TimeProfile.AlmostLike cuts ⋯ μ P T rho phi →
                                                                    TimeProfile.LocalGood cuts ⋯ chiGood gamma rho 0 T →
                                                                      eta ≤
                                                                          max (RiffleLowerV2.macroBeta μ T)
                                                                            (RiffleLowerV2.macroLambda1 μ T) →
                                                                        1 - epsilon ≤
                                                                          RiffleLowerV2.tv
                                                                            (RiffleLowerV2.physicalInverseLaw cuts)
                                                                            (RiffleLowerV2.uniformPermutation N)
def RiffleLowerV2.ScalarIntegrable : {k : ℕ} → TimeProfile.TimeLaw k → TimeProfile.BorelPartition k → ℝ → Prop :=
fun {k : ℕ} (μ : TimeProfile.TimeLaw k) (P : TimeProfile.BorelPartition k) (T : ℝ) =>
  (∀ (i : Fin P.cellCount), IntervalIntegrable (TimeProfile.cellMass μ P i) MeasureTheory.volume 0 T) ∧
    IntervalIntegrable (TimeProfile.profileMaxCost μ) MeasureTheory.volume 0 T ∧
      ∀ α ∈ Set.Icc 2 4, IntervalIntegrable (fun (t : ℝ) => TimeProfile.profilePsi μ t α) MeasureTheory.volume 0 T
