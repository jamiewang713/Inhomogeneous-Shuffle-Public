DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"Contracts.v1.FactorialOccupancy","name":"RiffleLowerV2.Targets.BonferroniProduct","type":"Prop","type_dependencies":[],"value":"∀ (m : ℕ),\n  2 ≤ m →\n    Even m →\n      ∀ (x y : ℕ),\n        (0 ≤ RiffleLowerV2.bonferroni m x * RiffleLowerV2.bonferroni m y - if 2 ≤ x ∧ 2 ≤ y then 1 else 0) ∧\n          (RiffleLowerV2.bonferroni m x * RiffleLowerV2.bonferroni m y - if 2 ≤ x ∧ 2 ≤ y then 1 else 0) ≤\n            RiffleLowerV2.bonferroniRemainder m x + RiffleLowerV2.bonferroniRemainder m y +\n              RiffleLowerV2.bonferroniRemainder m x * RiffleLowerV2.bonferroniRemainder m y","value_dependencies":["Nat","LE.le","instLENat","OfNat.ofNat","instOfNatNat","Even","instAddNat","And","Real","Real.instLE","Zero.toOfNat0","Real.instZero","HSub.hSub","instHSub","Real.instSub","HMul.hMul","instHMul","Real.instMul","RiffleLowerV2.bonferroni","ite","instDecidableAnd","Nat.decLe","One.toOfNat1","Real.instOne","HAdd.hAdd","instHAdd","Real.instAdd","RiffleLowerV2.bonferroniRemainder"]}
DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RiffleLowerV2.Factorial.PolynomialMoments","name":"RiffleLowerV2.Factorial.bonferroni_product_expect_error","type":"∀ {Ω : Type u_1} [inst : Fintype Ω] (P : PMF Ω) (X Y : Ω → ℕ) (μ ν ε : ℝ) (m : ℕ),\n  (∀ (r s : ℕ),\n      r + s ≤ 2 * m →\n        |(RiffleLowerV2.expect P fun (ω : Ω) => RiffleLowerV2.falling (X ω) r * RiffleLowerV2.falling (Y ω) s) -\n              μ ^ r * ν ^ s| ≤\n          ε * μ ^ r * ν ^ s) →\n    |(RiffleLowerV2.expect P fun (ω : Ω) => RiffleLowerV2.bonferroni m (X ω) * RiffleLowerV2.bonferroni m (Y ω)) -\n          (∑ r ∈ Finset.Icc 2 m, (-1) ^ r * ↑(r - 1) * μ ^ r / ↑r.factorial) *\n            ∑ s ∈ Finset.Icc 2 m, (-1) ^ s * ↑(s - 1) * ν ^ s / ↑s.factorial| ≤\n      (ε * ∑ r ∈ Finset.Icc 2 m, ↑(r - 1) * μ ^ r / ↑r.factorial) *\n        ∑ s ∈ Finset.Icc 2 m, ↑(s - 1) * ν ^ s / ↑s.factorial","type_dependencies":["Fintype","PMF","Nat","Real","LE.le","instLENat","HAdd.hAdd","instHAdd","instAddNat","HMul.hMul","instHMul","instMulNat","OfNat.ofNat","instOfNatNat","Real.instLE","abs","Real.lattice","Real.instAddGroup","HSub.hSub","instHSub","Real.instSub","RiffleLowerV2.expect","Real.instMul","RiffleLowerV2.falling","HPow.hPow","instHPow","NPow.toPow","Monoid.toNPow","Real.instMonoid","RiffleLowerV2.bonferroni","Finset.sum","Real.instAddCommMonoid","Finset.Icc","Nat.instPreorder","Nat.instLocallyFiniteOrder","HDiv.hDiv","instHDiv","DivInvMonoid.toDiv","Real.instDivInvMonoid","Neg.neg","Real.instNeg","One.toOfNat1","Real.instOne","Nat.cast","Real.instNatCast","instSubNat","Nat.factorial"],"value":"","value_dependencies":["Fintype","PMF","Nat","Real","LE.le","instLENat","HAdd.hAdd","instHAdd","instAddNat","HMul.hMul","instHMul","instMulNat","OfNat.ofNat","instOfNatNat","Real.instLE","abs","Real.lattice","Real.instAddGroup","HSub.hSub","instHSub","Real.instSub","RiffleLowerV2.expect","Real.instMul","RiffleLowerV2.falling","HPow.hPow","instHPow","NPow.toP