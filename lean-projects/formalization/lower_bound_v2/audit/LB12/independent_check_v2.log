DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"RiffleTimeProfile.Base","name":"TimeProfile.BorelPartition.IsRegular.recOn","type":"{k : ℕ} →\n  {P : TimeProfile.BorelPartition k} →\n    {chi C : ℝ} →\n      {motive : P.IsRegular chi C → Sort u} →\n        (t : P.IsRegular chi C) →\n          ((psi_oscillation :\n                ∀ (i : Fin P.cellCount) (p p' : TimeProfile.Simplex k),\n                  P.classify p = i →\n                    P.classify p' = i →\n                      ∀ theta ∈ Set.Icc 2 4, |TimeProfile.psi p theta - TimeProfile.psi p' theta| ≤ C * chi) →\n              (maxCost_oscillation :\n                  ∀ (i : Fin P.cellCount) (p p' : TimeProfile.Simplex k),\n                    P.classify p = i → P.classify p' = i → |TimeProfile.maxCost p - TimeProfile.maxCost p'| ≤ C * chi) →\n                (good_digit :\n                    ∀ (i : Fin P.cellCount) (p : TimeProfile.Simplex k) (l : Fin k),\n                      P.classify p = i →\n                        2 * chi < TimeProfile.prob (P.rep i) l →\n                          chi < TimeProfile.prob p l ∧\n                            |TimeProfile.digitCost (TimeProfile.prob p l) -\n                                  TimeProfile.digitCost (TimeProfile.prob (P.rep i) l)| ≤\n                              C * chi) →\n                  (exceptional_digit :\n                      ∀ (i : Fin P.cellCount) (p : TimeProfile.Simplex k) (l : Fin k),\n                        P.classify p = i → TimeProfile.prob (P.rep i) l ≤ 2 * chi → TimeProfile.prob p l ≤ 3 * chi) →\n                    motive ⋯) →\n            motive t","type_dependencies":["Nat","TimeProfile.BorelPartition","Real","TimeProfile.BorelPartition.IsRegular","Fin","TimeProfile.BorelPartition.cellCount","TimeProfile.Simplex","Eq","TimeProfile.BorelPartition.classify","Membership.mem","Set","Set.instMembership","Set.Icc","Real.instPreorder","OfNat.ofNat","instOfNatAtLeastTwo","Real.instNatCast"