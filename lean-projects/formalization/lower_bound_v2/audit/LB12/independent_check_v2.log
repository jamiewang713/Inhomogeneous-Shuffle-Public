DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RiffleLowerV2.Localization.Words","name":"RiffleLowerV2.joinColdWord.eq_1","type":"∀ {k K : ℕ} {P : TimeProfile.BorelPartition k} {W : RiffleLowerV2.ColdWitnessData}\n  (G : RiffleLowerV2.ColdGeometryData K P W) (x : RiffleLowerV2.WordOn k (RiffleLowerV2.prefixColumns K W))\n  (v : RiffleLowerV2.WordOn k (RiffleLowerV2.bridgeColumns K W))\n  (z : RiffleLowerV2.WordOn k (RiffleLowerV2.tailColumns K W)),\n  RiffleLowerV2.joinColdWord G x v z =\n    List.Vector.ofFn fun (j : Fin K) =>\n      if hj : j ∈ RiffleLowerV2.prefixColumns K W then x ⟨j, hj⟩\n      else\n        if hj : j ∈ RiffleLowerV2.bridgeColumns K W then v ⟨j, hj⟩\n        else if hj : j ∈ RiffleLowerV2.tailColumns K W then z ⟨j, hj⟩ else List.Vector.get G.ambient j","type_dependencies":["Nat","TimeProfile.BorelPartition","RiffleLowerV2.ColdWitnessData","RiffleLowerV2.ColdGeometryData","RiffleLowerV2.WordOn","RiffleLowerV2.prefixColumns","RiffleLowerV2.bridgeColumns","RiffleLowerV2.tailColumns","Eq","RiffleLowerV2.Word","RiffleLowerV2.joinColdWord","List.Vector.ofFn","Fin","dite","Membership.mem","Finset","SetLike.instMembership","Finset.instSetLike","Finset.decidableMem","instDecidableEqFin","Subtype.mk","Not","List.Vector.get","RiffleLowerV2.ColdGeometryData.ambient"],"value":"","value_dependencies":["Nat","TimeProfile.BorelPartition","RiffleLowerV2.ColdWitnessData","RiffleLowerV2.ColdGeometryData","RiffleLowerV2.WordOn","RiffleLowerV2.prefixColumns","RiffleLowerV2.bridgeColumns","RiffleLowerV2.tailColumns","Eq.refl","RiffleLowerV2.Word","RiffleLowerV2.joinColdWord"]}
