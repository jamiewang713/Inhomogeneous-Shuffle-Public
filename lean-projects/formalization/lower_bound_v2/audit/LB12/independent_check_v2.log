DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RiffleLowerV2.Thinning.Process","name":"RiffleLowerV2.Thinning.thinningTails","type":"∀ (M d : ℕ),\n  0 < M →\n    ∀ (m : Fin d → ℕ),\n      (∀ (j : Fin d), m j ≤ M) →\n        (∀ (t : ℝ),\n            0 < t →\n              (RiffleLowerV2.probability (PMF.uniformOfFintype (Fin d → RiffleLowerV2.Permutation M))\n                  fun (ω : Fin d → RiffleLowerV2.Permutation M) =>\n                  t ≤ |↑(RiffleLowerV2.Targets.thinningCount m ω) - ↑M * RiffleLowerV2.Targets.thinningQ M m|) ≤\n                2 * Real.exp (-t ^ 2 / (4 * (↑M * RiffleLowerV2.Targets.thinningQ M m + t)))) ∧\n          (RiffleLowerV2.probability (PMF.uniformOfFintype (Fin d → RiffleLowerV2.Permutation M))\n                fun (ω : Fin d → RiffleLowerV2.Permutation M) =>\n                ↑(RiffleLowerV2.Targets.thinningCount m ω) ≤ ↑M * RiffleLowerV2.Targets.thinningQ M m / 2) ≤\n              Real.exp (-RiffleLowerV2.chernoffConstant * (↑M * RiffleLowerV2.Targets.thinningQ M m)) ∧\n            (RiffleLowerV2.probability (PMF.uniformOfFintype (Fin d → RiffleLowerV2.Permutation M))\n                fun (ω : Fin d → RiffleLowerV2.Permutation M) => RiffleLowerV2.Targets.thinningCount m ω < 2) ≤\n              2 * Real.exp (-(↑M * RiffleLowerV2.Targets.thinningQ M m) / 2)","type_dependencies":["Nat","LT.lt","instLTNat","OfNat.ofNat","instOfNatNat","Fin","LE.le","instLENat","And","Real","Real.instLT","Zero.toOfNat0","Real.instZero","Real.instLE","RiffleLowerV2.probability","RiffleLowerV2.Permutation","Pi.instFintype","instDecidableEqFin","Fin.fintype","Equiv.instFintype","PMF.uniformOfFintype","Pi.instNonempty","instNonemptyOfInhabited","Equiv.inhabited'","abs","Real.lattice","Real.instAddGroup","HSub.hSub","instHSub","Real.instSub","Nat.cast","Real.instNatCast","RiffleLowerV2.Targets.thinningCount","HMul.hMul","instHMul","Real.instMul","RiffleLowerV2.Targets.thinningQ","instOfNatAtLeastTwo","Nat.in