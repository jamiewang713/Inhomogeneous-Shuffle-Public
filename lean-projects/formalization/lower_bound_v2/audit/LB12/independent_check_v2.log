) G.ambient)))\n              omega →\n          RiffleLowerV2.upperRank\n                (RiffleLowerV2.prefixAt (W.mu + W.bridgeLength)\n                  (RiffleLowerV2.joinColdWord G x G.reservePlus\n                    (RiffleLowerV2.restrictWord (RiffleLowerV2.tailColumns K W) G.ambient)))\n                omega ≤\n              RiffleLowerV2.upperRank (RiffleLowerV2.prefixAt W.mu (RiffleLowerV2.joinColdWord G x G.central z)) omega →\n            RiffleLowerV2.lowerRank\n                    (RiffleLowerV2.prefixAt (W.mu + W.bridgeLength)\n                      (RiffleLowerV2.joinColdWord G x G.reserveMinus\n                        (RiffleLowerV2.restrictWord (RiffleLowerV2.tailColumns K W) G.ambient)))\n                    omega +\n                  RiffleLowerV2.prefixCount\n                    (RiffleLowerV2.prefixAt (W.mu + W.bridgeLength)\n                      (RiffleLowerV2.joinColdWord G x G.reserveMinus\n                        (RiffleLowerV2.restrictWord (RiffleLowerV2.tailColumns K W) G.ambient)))\n                    omega =\n                RiffleLowerV2.upperRank\n                  (RiffleLowerV2.prefixAt (W.mu + W.bridgeLength)\n                    (RiffleLowerV2.joinColdWord G x G.reserveMinus\n                      (RiffleLowerV2.restrictWord (RiffleLowerV2.tailColumns K W) G.ambient)))\n                  omega →\n              RiffleLowerV2.lowerRank\n                      (RiffleLowerV2.prefixAt (W.mu + W.bridgeLength)\n                        (RiffleLowerV2.joinColdWord G x G.reservePlus\n                          (RiffleLowerV2.restrictWord (RiffleLowerV2.tailColumns K W) G.ambient)))\n                      omega +\n                    RiffleLowerV2.prefixCount\n                      (RiffleLowerV2.prefixAt (W.mu + W.bridgeLength)\n                        (RiffleLowerV2.joinColdWord G x G.reservePlus\n                          (RiffleLowerV2.restrictWord (RiffleLowerV2.tailColumns K W) G.ambient)))\n                      omega =\n          