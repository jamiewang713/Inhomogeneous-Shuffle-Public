DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"Contracts.v1.Endpoints","name":"RiffleLowerV2.Targets.MacroscopicIntegrableTarget","type":"Prop","type_dependencies":[],"value":"∀ (k : ℕ),\n  2 ≤ k →\n    ∀ (T eta : ℝ),\n      0 < T →\n        0 < eta →\n          ∃ (chiPartition : ℝ),\n            0 < chiPartition ∧\n              chiPartition < 1 / ↑k ∧\n                ∃ (P : TimeProfile.BorelPartition k),\n                  P.IsRegular chiPartition 1 ∧\n                    ∃ (rho0 : ℝ),\n                      0 < rho0 ∧\n                        2 * rho0 * Real.log ↑k ≤ RiffleLowerV2.kappa0 (eta / 2) / 100 ∧\n                          ∀ (rho : ℝ),\n                            0 < rho →\n                              rho ≤ rho0 →\n                                ∃ (phi0 : ℝ),\n                                  0 < phi0 ∧\n                                    ∀ (phi : ℝ),\n                                      0 < phi →\n                                        phi ≤ phi0 →\n                                          ∀ (chiGood gamma : ℝ),\n                                            0 < chiGood →\n                                              0 < gamma →\n                                                ∀ (epsilon : ℝ),\n                                                  0 < epsilon →\n                                                    ∀ (μ : TimeProfile.TimeLaw k),\n                                                      RiffleLowerV2.ScalarIntegrable μ P T →\n                                                        ∃ (N0 : ℕ),\n                                                          2 ≤ N0 ∧\n                                                            ∀ (N : ℕ) (hN : 2 ≤ N),\n                                                              N0 ≤ N →\n                                                                ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),\n                                                                  TimeProfile.AlmostLike cuts ⋯ μ P T rho phi →\n                                                                    TimeProfile.LocalGood cuts ⋯ chiGood gamma rho 0 T →\n                                                                      eta ≤\n                                                                          max (RiffleLowerV2.macroBeta μ T)\n                                                                            (RiffleLowerV2.macroLambda1 μ T) →\n                                                                        1 - epsilon ≤\n                                                                          RiffleLowerV2.tv\n                                                                            (RiffleLowerV2.physicalInverseLaw cuts)\n                                                                            (RiffleLowerV2.uniformPermutation N)","value_dependencies":["Nat","LE.le","instLENat","OfNat.ofNat","instOfNatNat","Real","LT.lt","Real.instLT","Zero.toOfNat0","Real.instZero","Exists","And","HDiv.hDiv","instHDiv","DivInvMonoid.toDiv","Real.instDivInvMonoid","One.toOfNat1","Real.instOne","Nat.cast","Real.instNatCast","TimeProfile.BorelPartition","TimeProfile.BorelPartition.IsRegular","Real.instLE","HMul.hMul","instHMul","Real.instMul","instOfNatAtLeastTwo","RiffleLowerV2.Targets.ProfileIntervalErrors._proof_1","Real.log","RiffleLowerV2.kappa0","RiffleLowerV2.Targets.ColdParameters._proof_1","TimeProfile.TimeLaw","RiffleLowerV2.ScalarIntegrable","RiffleLowerV2.Targets.HorizonCuts","TimeProfile.AlmostLike","TimeProfile.horizonDepth","RiffleLowerV2.Targets.deckPos","TimeProfile.LocalGood","Max.max","Real.instMax","RiffleLowerV2.macroBeta","RiffleLowerV2.macroLambda1","HSub.hSub","instHSub","Real.instSub","RiffleLowerV2.tv","RiffleLowerV2.Permutation","Equiv.instFintype","Fin","instDecidableEqFin","Fin.fintype","RiffleLowerV2.physicalInverseLaw","RiffleLowerV2.uniformPermutation"]}
