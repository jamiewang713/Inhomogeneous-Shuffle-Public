DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"constructor","module":"RiffleTimeProfile.Base","name":"TimeProfile.BorelPartition.IsRegular.mk","type":"∀ {k : ℕ} {P : TimeProfile.BorelPartition k} {chi C : ℝ},\n  (∀ (i : Fin P.cellCount) (p p' : TimeProfile.Simplex k),\n      P.classify p = i →\n        P.classify p' = i → ∀ theta ∈ Set.Icc 2 4, |TimeProfile.psi p theta - TimeProfile.psi p' theta| ≤ C * chi) →\n    (∀ (i : Fin P.cellCount) (p p' : TimeProfile.Simplex k),\n        P.classify p = i → P.classify p' = i → |TimeProfile.maxCost p - TimeProfile.maxCost p'| ≤ C * chi) →\n      (∀ (i : Fin P.cellCount) (p : TimeProfile.Simplex k) (l : Fin k),\n          P.classify p = i →\n            2 * chi < TimeProfile.prob (P.rep i) l →\n              chi < TimeProfile.prob p l ∧\n                |TimeProfile.digitCost (TimeProfile.prob p l) - TimeProfile.digitCost (TimeProfile.prob (P.rep i) l)| ≤\n                  C * chi) →\n        (∀ (i : Fin P.cellCount) (p : TimeProfile.Simplex k) (l : Fin k),\n            P.classify p = i → TimeProfile.prob (P.rep i) l ≤ 2 * chi → TimeProfile.prob p l ≤ 3 * chi) →\n          P.IsRegular chi C","type_dependencies":["Nat","TimeProfile.BorelPartition","Real","Fin","TimeProfile.BorelPartition.cellCount","TimeProfile.Simplex","Eq","TimeProfile.BorelPartition.classify","Membership.mem","Set","Set.instMembership","Set.Icc","Real.instPreorder","OfNat.ofNat","instOfNatAtLeastTwo","Real.instNatCast","Nat.instAtLeastTwoHAddOfNat","instOfNatNat","Nat.instNeZeroSucc","LE.le","Real.instLE","abs","Real.lattice","Real.instAddGroup","HSub.hSub","instHSub","Real.instSub","TimeProfile.psi","HMul.hMul","instHMul","Real.instMul","TimeProfile.maxCost","LT.lt","Real.instLT","TimeProfile.prob","TimeProfile.BorelPartition.rep","And","TimeProfile.digitCost","TimeProfile.BorelPartition.IsRegular"],"value":"","value_dependencies":[]}
