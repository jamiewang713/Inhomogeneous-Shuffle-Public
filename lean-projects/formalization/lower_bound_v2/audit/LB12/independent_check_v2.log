DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"Contracts.v1.TransferFinite","name":"RiffleLowerV2.Targets.ResidualMeanComparison","type":"Prop","type_dependencies":[],"value":"∀ (c C : ℝ),\n  0 < c →\n    0 < C →\n      ∀ (b0 : ℕ),\n        ∃ (D : ℝ),\n          0 < D ∧\n            ∃ (N0 : ℕ),\n              b0 < N0 ∧\n                2 ≤ N0 ∧\n                  ∀ N ≥ N0,\n                    ∀ (k K b : ℕ),\n                      b ≤ b0 →\n                        ↑K ≤ C * TimeProfile.logScale N →\n                          ∀ (cuts : TimeProfile.Cuts k N K) (p : RiffleLowerV2.RowPrescription N k K b)\n                            (w : RiffleLowerV2.Word k K),\n                            Function.Injective p.row →\n                              0 <\n                                  RiffleLowerV2.probability (TimeProfile.fixedCountPMF cuts)\n                                    (RiffleLowerV2.prescriptionEvent p) →\n                                (∀ (j : Fin K), c * ↑N ≤ ↑(cuts.count j (List.Vector.get w j))) →\n                                  |RiffleLowerV2.Targets.residualWordMean cuts p w -\n                                        ↑N * RiffleLowerV2.wordMass cuts w| ≤\n                                    D * (↑K + 1) * ↑b / ↑N * (↑N * RiffleLowerV2.wordMass cuts w)","value_dependencies":["Real","LT.lt","Real.instLT","OfNat.ofNat","Zero.toOfNat0","Real.instZero","Nat","Exists","And","instLTNat","LE.le","instLENat","instOfNatNat","GE.ge","Real.instLE","Nat.cast","Real.instNatCast","HMul.hMul","instHMul","Real.instMul","TimeProfile.logScale","TimeProfile.Cuts","RiffleLowerV2.RowPrescription","RiffleLowerV2.Word","Function.Injective","Fin","RiffleLowerV2.RowPrescription.row","RiffleLowerV2.probability","TimeProfile.ShuffleSample","TimeProfile.instFintypeShuffleSample","TimeProfile.fixedCountPMF","RiffleLowerV2.prescriptionEvent","TimeProfile.Cuts.count","List.Vector.get","abs","Real.lattice","Real.instAddGroup","