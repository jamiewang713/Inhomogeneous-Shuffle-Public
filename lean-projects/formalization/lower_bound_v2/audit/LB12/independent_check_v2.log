DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RiffleLowerV2.Thinning.Residual.Prefix","name":"RiffleLowerV2.Thinning.residualPrefixExpect","type":"∀ {N k K b : ℕ} (cuts : TimeProfile.Cuts k N K) (r : RiffleLowerV2.RowPrescription N k K b),\n  b < N →\n    Function.Injective r.row →\n      0 < RiffleLowerV2.probability (TimeProfile.fixedCountPMF cuts) (RiffleLowerV2.prescriptionEvent r) →\n        ∃ (residual : TimeProfile.Cuts k (N - b) K),\n          (∀ (j : Fin K) (a : Fin k), residual.count j a = cuts.count j a - RiffleLowerV2.usedCount r j a) ∧\n            ∀ (e : Fin (N - b) → Fin N),\n              Function.Injective e →\n                (∀ (i : Fin N), (∃ (q : Fin (N - b)), e q = i) ↔ ¬∃ (q : Fin b), r.row q = i) →\n                  ∀ (w : RiffleLowerV2.Prefix k K) (F : ℕ → ℝ),\n                    RiffleLowerV2.conditionalExpect (TimeProfile.fixedCountPMF cuts)\n                        (fun (ω : TimeProfile.ShuffleSample cuts) =>\n                          F (RiffleLowerV2.Thinning.residualPrefixCount r w ω))\n                        (RiffleLowerV2.prescriptionEvent r) =\n                      RiffleLowerV2.expect (TimeProfile.fixedCountPMF residual)\n                        fun (η : TimeProfile.ShuffleSample residual) => F (RiffleLowerV2.prefixCount w η)","type_dependencies":["Nat","TimeProfile.Cuts","RiffleLowerV2.RowPrescription","LT.lt","instLTNat","Function.Injective","Fin","RiffleLowerV2.RowPrescription.row","Real","Real.instLT","OfNat.ofNat","Zero.toOfNat0","Real.instZero","RiffleLowerV2.probability","TimeProfile.ShuffleSample","TimeProfile.instFintypeShuffleSample","TimeProfile.fixedCountPMF","RiffleLowerV2.prescriptionEvent","Exists","HSub.hSub","instHSub","instSubNat","And","Eq","TimeProfile.Cuts.count","RiffleLowerV2.usedCount","Iff","Not","RiffleLowerV2.Prefix","RiffleLowerV2.conditionalExpect","RiffleLowerV2.Thinning.residualPrefixCount","RiffleLowerV2.expect","RiffleLowerV2.prefixCount"],"val