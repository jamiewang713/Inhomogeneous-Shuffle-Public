theorem RiffleLowerV2.EmpiricalLower.empiricalCombined : RiffleLowerV2.Targets.EmpiricalCombinedTarget :=
fun (k : ℕ) (hk : 2 ≤ k) (T etaLargest etaCold : ℝ) (hT : 0 < T) (hLargest : 0 < etaLargest) (hCold : 0 < etaCold)
    (chi gamma rho ε : ℝ) (hε : 0 < ε) =>
  Exists.casesOn (RiffleLowerV2.EmpiricalLower.largestOnly k hk T etaLargest hT hLargest ε hε)
    fun (Nl : ℕ)
      (h :
        2 ≤ Nl ∧
          ∀ (N : ℕ) (hN : 2 ≤ N),
            Nl ≤ N →
              ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                etaLargest ≤
                    RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                      (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) →
                  1 - ε ≤
                    RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts) (RiffleLowerV2.uniformPermutation N)) =>
    And.casesOn h
      fun (hNl : 2 ≤ Nl)
        (hlargest :
          ∀ (N : ℕ) (hN : 2 ≤ N),
            Nl ≤ N →
              ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                etaLargest ≤
                    RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                      (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) →
                  1 - ε ≤
                    RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts) (RiffleLowerV2.uniformPermutation N)) =>
      if hparams : RiffleLowerV2.Targets.ColdParameters k etaCold chi gamma rho then
        have hk0 :=
          id
            (id
              (lt_min
                (div_pos
                  (div_pos hCold
                    (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 1000))
                      (Eq.refl (Nat.ble 1 1000))))
                  (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 100))
                    (Eq.refl (Nat.ble 1 100))))
                (div_pos
                  (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one)
                    (Eq.refl (Nat.ble 1 1)))
                  (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 1000))
                    (Eq.refl (Nat.ble 1 1000))))));
        Exists.casesOn (RiffleLowerV2.EmpiricalLower.largestOnly k hk T (RiffleLowerV2.kappa0 etaCold) hT hk0 ε hε)
          fun (Ns : ℕ)
            (h :
              2 ≤ Ns ∧
                ∀ (N : ℕ) (hN : 2 ≤ N),
                  Ns ≤ N →
                    ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                      RiffleLowerV2.kappa0 etaCold ≤
                          RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                            (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) →
                        1 - ε ≤
                          RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                            (RiffleLowerV2.uniformPermutation N)) =>
          And.casesOn h
            fun (left : 2 ≤ Ns)
              (hsplit :
                ∀ (N : ℕ) (hN : 2 ≤ N),
                  Ns ≤ N →
                    ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                      RiffleLowerV2.kappa0 etaCold ≤
                          RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                            (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) →
                        1 - ε ≤
                          RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                            (RiffleLowerV2.uniformPermutation N)) =>
            Exists.casesOn (RiffleLowerV2.EmpiricalLower.coldOnly k hk T etaCold hT hCold chi gamma rho hparams ε hε)
              fun (Nc : ℕ)
                (h :
                  2 ≤ Nc ∧
                    ∀ (N : ℕ) (hN : 2 ≤ N),
                      Nc ≤ N →
                        ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                          TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T →
                            etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN) →
                              RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                                    (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) <
                                  RiffleLowerV2.kappa0 etaCold →
                                1 - ε ≤
                                  RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                                    (RiffleLowerV2.uniformPermutation N)) =>
              And.casesOn h
                fun (left : 2 ≤ Nc)
                  (hcold :
                    ∀ (N : ℕ) (hN : 2 ≤ N),
                      Nc ≤ N →
                        ∀ (cuts : RiffleLowerV2.Targets.HorizonCuts k N T),
                          TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T →
                            etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN) →
                              RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                                    (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) <
                                  RiffleLowerV2.kappa0 etaCold →
                                1 - ε ≤
                                  RiffleLowerV2.tv (RiffleLowerV2.physicalInverseLaw cuts)
                                    (RiffleLowerV2.uniformPermutation N)) =>
                Exists.intro (max Nl (max Ns Nc))
                  ⟨LE.le.trans hNl (le_max_left Nl (max Ns Nc)),
                    fun (N : ℕ) (hN : 2 ≤ N) (hlarge : max Nl (max Ns Nc) ≤ N)
                      (cuts : RiffleLowerV2.Targets.HorizonCuts k N T)
                      (halt :
                        RiffleLowerV2.Targets.EmpiricalAlternative T cuts (RiffleLowerV2.Targets.deckPos hN) etaLargest
                          etaCold chi gamma rho) =>
                    have hlN := LE.le.trans (le_max_left Nl (max Ns Nc)) hlarge;
                    have hsN := LE.le.trans (LE.le.trans (le_max_left Ns Nc) (le_max_right Nl (max Ns Nc))) hlarge;
                    have hcN := LE.le.trans (LE.le.trans (le_max_right Ns Nc) (le_max_right Nl (max Ns Nc))) hlarge;
                    Or.casesOn halt
                      (fun
                          (hl :
                            etaLargest ≤
                              RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                                (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T))) =>
                        hlargest N hN hlN cuts hl)
                      fun
                        (h :
                          RiffleLowerV2.Targets.ColdParameters k etaCold chi gamma rho ∧
                            TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T ∧
                              etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN)) =>
                      And.casesOn h
                        fun (left : RiffleLowerV2.Targets.ColdParameters k etaCold chi gamma rho)
                          (right :
                            TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T ∧
                              etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN)) =>
                        And.casesOn right
                          fun (hgood : TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T)
                            (hmargin : etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN)) =>
                          if hs :
                              RiffleLowerV2.kappa0 etaCold ≤
                                RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                                  (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T)) then
                            hsplit N hN hsN cuts hs
                          else hcold N hN hcN cuts hgood hmargin (lt_of_not_ge hs)⟩
      else
        Exists.intro Nl
          ⟨hNl,
            fun (N : ℕ) (hN : 2 ≤ N) (hlarge : Nl ≤ N) (cuts : RiffleLowerV2.Targets.HorizonCuts k N T)
              (halt :
                RiffleLowerV2.Targets.EmpiricalAlternative T cuts (RiffleLowerV2.Targets.deckPos hN) etaLargest etaCold
                  chi gamma rho) =>
            Or.casesOn halt
              (fun
                  (hl :
                    etaLargest ≤
                      RiffleLowerV2.beta cuts (RiffleLowerV2.Targets.deckPos hN)
                        (RiffleLowerV2.horizon N (TimeProfile.horizonDepth N T))) =>
                hlargest N hN hlarge cuts hl)
              fun
                (h :
                  RiffleLowerV2.Targets.ColdParameters k etaCold chi gamma rho ∧
                    TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T ∧
                      etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN)) =>
              And.casesOn h
                fun (hp : RiffleLowerV2.Targets.ColdParameters k etaCold chi gamma rho)
                  (right :
                    TimeProfile.LocalGood cuts (RiffleLowerV2.Targets.deckPos hN) chi gamma rho 0 T ∧
                      etaCold ≤ RiffleLowerV2.lambda1 cuts (RiffleLowerV2.Targets.deckPos hN)) =>
                False.elim (hparams hp)⟩
theorem RiffleLowerV2.MacroscopicLower.macroscopicIntegrable : RiffleLowerV2.Targets.MacroscopicIntegrableTarget :=
fun (k : ℕ) (hk : 2 ≤ k) (T eta : ℝ) (hT : 0 < T) (heta : 0 < eta) =>
  have he := RiffleLowerV2.MacroscopicLower.transferAccuracy_spec heta;
  have hk0 := RiffleLowerV2.MacroscopicLower.coldMargin_scale heta;
  have hceiling := RiffleLowerV2.MacroscopicLower.bridgeCeiling_spec hk heta;
  Exists.casesOn
    (RiffleLowerV2.ProfileTransfer.profileTransfer k hk T (RiffleLowerV2.MacroscopicLower.transferAccuracy eta)
      (RiffleLowerV2.MacroscopicLower.bridgeCeiling k eta) hT he.left hceiling.left)
    fun (chi : ℝ)
      (h :
        0 < chi ∧
          chi < 1 / ↑k ∧
            ∃ (P : TimeProfile.BorelPartition k),
              P.IsRegular chi 1 ∧
                ∃ (rho0 : ℝ),
                  0 < rho0 ∧
                    rho0 ≤ RiffleLowerV2.MacroscopicLower.bridgeCeiling k eta ∧
                      ∀ (rho : ℝ),
                        0 < rho →
                          rho ≤ rho0 →
