                                                                  Filter.atTop (nhds 1) →
                                                                Filter.Tendsto
                                                                  (fun N =>
                                                                    RiffleUpperV2.tv
                                                                      (RiffleUpperV2.randomInverseLaw (Q N))
                                                                      (RiffleUpperV2.uniformPermutation N))
