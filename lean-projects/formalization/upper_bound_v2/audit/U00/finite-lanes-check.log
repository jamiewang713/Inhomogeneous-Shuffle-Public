iffleUpperV2.Sample cuts) =>\n                                      ↑(X a (m a) ω - X a i ω))\n                                    fun (ω : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts) =>\n                                    h a i ω = h a i v) ≤\n                                  γ) →\n                      (∀ (ω : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts),\n                          S1 ω.1 ∧ S1 ω.2 → ∀ (a : Fin d), RiffleUpperV2.Exponential.goodPrefix (B a) (m a) ω) →\n                        (∀ (ω : RiffleUpperV2.Sample cuts × RiffleUpperV2.Sample cuts),\n                            S1 ω.1 ∧ S1 ω.2 →\n                              Finset.card (RiffleUpperV2.shuffleEdges ω.1 ∩ RiffleUpperV2.shuffleEdges ω.2) ≤\n                                ∑ a : Fin d, X a (m a) ω) →\n                          (∀ (ω ω' : RiffleUpperV2.Sample cuts),\n                              S1 ω →\n                                S1 ω' →\n                                  RiffleUpperV2.GraphOverlap.overlap (RiffleUpperV2.shuffleEdges ω)\n                                      (RiffleUpperV2.shuffleEdges ω') ≤\n                                    b ^ Finset.card (RiffleUpperV2.shuffleEdges ω ∩ RiffleUpperV2.shuffleEdges ω')) →\n                            (b ^ d - 1) * γ < 1 →\n                              RiffleUpperV2.tv (RiffleUpperV2.physicalInverseLaw cuts)\n                                  (RiffleUpperV2.uniformPermutation N) ≤\n                                √((b ^ d - 1) * γ / (1 - (b ^ d - 1) * γ)) / 2 +\n                                  RiffleUpperV2.probability (RiffleUpperV2.fixedCountPMF cuts)\n                                    fun (ω : TimeProfile.ShuffleSample cuts) => ¬S1 ω"}
