eUpperV2.Reservoir.tupleWords e z q) =\n                                                                v)\n                                                          fun (z : TimeProfile.ShuffleSample cuts) =>\n                                                          RiffleUpperV2.Reservoir.pileBase cuts p e A a z ∧\n                                                            RiffleUpperV2.Exploration.historyFiber cuts p\n                                                              RiffleUpperV2.Exploration.Direction.backward (↑j + 1) ω\n                                                              z) ≤\n                                                        2 ^ (Finset.univ \\ A).card *\n                                                            RiffleUpperV2.Exploration.tailMass cuts E v ^\n                                                              (↑(Finset.univ \\ A).card *\n                                                                (1 - Real.log (1 / g) / Real.log (1 / τ))) /\n                                                          (RiffleUpperV2.Exploration.reserveMass k D g ^\n                                                              (Finset.univ \\ A).card /\n                                                            2)"}
