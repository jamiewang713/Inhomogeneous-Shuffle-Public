                RiffleUpperV2.Exploration.hasDirection cuts D g\n                                          RiffleUpperV2.Exploration.Direction.backward\n                                          (RiffleUpperV2.Reservoir.backwardWords cuts p ω j) →\n                                        ∀ (A : Finset (Fin (RiffleUpperV2.Exploration.pileSize cuts p)))\n                                          (a :\n                                            Fin (RiffleUpperV2.Exploration.pileSize cuts p) →\n                                              RiffleUpperV2.Word k (L + 1)),\n                                          (Finset.univ \\ A).card = 1 ∨ (Finset.univ \\ A).card = 2 →\n                                            ∀ (ω₀ : RiffleUpperV2.Sample cuts),\n                                              RiffleUpperV2.Reservoir.pileBase cuts p e A a ω₀ →\n                                                RiffleUpperV2.Exploration.concentrationEvent cuts D g ξ ω₀ →\n                                                  ∀ (E : ℕ) (v : RiffleUpperV2.Word k (min E L)),\n                                                    (∀ (w : RiffleUpperV2.Word k (L + 1)),\n                                                        List.Vector.get w 0 = p →\n                                                          RiffleUpperV2.Exploration.tailPrefix E w = v →\n                                                            w < RiffleUpperV2.Reservoir.backwardWords cuts p ω j) →\n                                                      (RiffleUpperV2.conditionalProbability\n                                                          (RiffleUpperV2.fixedCountPMF cuts)\n                                                          (fun (z : TimeProfile.ShuffleSample cuts) =>\n                                                            ∀ q ∉ A,\n                                                              RiffleUpperV2.Exploration.tailPrefix E\n                                                                  (RiffleUpperV2.Reservoir.tupleWords e z q) =\n                                                                v)\n                                                          fun (z : TimeProfile.ShuffleSample cuts) =>\n                                                          RiffleUpperV2.Reservoir.pileBase cuts p e A a z ∧\n                                                            RiffleUpperV2.Exploration.historyFiber cuts p\n                                                              RiffleUpperV2.Exploration.Direction.backward (↑j + 1) ω\n                                                              z) ≤\n                                                        2 ^ (Finset.univ \\ A).card *\n                                                            RiffleUpperV2.Exploration.tailMass cuts E v ^\n                                                              (↑(Finset.univ \\ A).card *\n                                                                (1 - Real.log (1 / g) / Real.log (1 / τ))) /\n                                                          (RiffleUpperV2.Exploration.reserveMass k D g ^\n                                                              (Finset.univ \\ A).card /\n                                                            2)"}
