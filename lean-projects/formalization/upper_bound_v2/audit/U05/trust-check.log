                                  (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) C chi delta\n                                    hchiK) =>\n                              (↑t.snd).2.2)\n                            s).fst →\n                    (fun\n                              (t :\n                                RiffleUpperV2.FirstMoment.RetainedAtPile hk N\n                                  (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\n                                  (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) C chi delta hchiK) =>\n                            RiffleUpperV2.Localization.meanExponent N (RiffleUpperV2.Hypergeometric.tailCuts cuts)\n                              ((fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) t.fst)\n                              ((fun\n                                    (t :\n                                      RiffleUpperV2.FirstMoment.RetainedAtPile hk N\n                                        (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\n                                        (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) C chi delta\n                                        hchiK) =>\n                                  (↑t.snd).2.2)\n                                t))\n                          s ≤\n                        2 * delta →\n                      (fun\n                                  (t :\n                                    RiffleUpperV2.FirstMoment.RetainedAtPile hk N\n                                      (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\n                                      (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) C chi delta\n                                      hchiK) =>\n                                Real.log\n                                    ↑(RiffleUpperV2.FirstMoment.classPrefixes hk hN\n                                          (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\n                                          (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) T C chi delta\n                                          width hchi hchi1 hchiK hwidth hd t).card /\n                                  TimeProfile.logScale N)\n                              s +\n                            4 *\n                              (fun\n                                    (t :\n                                      RiffleUpperV2.FirstMoment.RetainedAtPile hk N\n                                        (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\n                                        (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) C chi delta\n                                        hchiK) =>\n                                  RiffleUpperV2.Localization.meanExponent N (RiffleUpperV2.Hypergeometric.tailCuts cuts)\n                                    ((fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) t.fst)\n                                    ((fun\n                                          (t :\n                                            RiffleUpperV2.FirstMoment.RetainedAtPile hk N\n                                              (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\n                                              (fun (a : Fin k) => RiffleUpperV2.Hypergeometric.anchorRows c a) C chi\n                                              delta hchiK) =>\n                                        (↑t.snd).2.2)\n                                      t))\n                                s -\n                          2 *\n                            RiffleUpperV2.empiricalB N a₀ cuts hn 2\n                              (a₀ + 1 +\n                                ↑((fun\n                                          (t :\n                                            RiffleUpperV2.FirstMoment.RetainedAtPile hk N\n                                              (RiffleUpperV2.Hypergeometric.tailCuts cuts) hn\