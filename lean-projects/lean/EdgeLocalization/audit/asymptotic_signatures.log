          0 < ε →
            ∃ N0,
              2 ≤ N0 ∧
                ∀ (N : ℕ),
                  N0 ≤ N →
                    ∀ (δ : ℝ) (M : ℕ) (hM : M ≤ K N) (hAM : A N ≤ M) (x : Fin M → Fin k),
                      (∀ (t : Fin (A N)), x (Fin.castLE hAM t) = w N t) →
                        EdgeLocalization.legalPrefix (n N) hM x →
                          EdgeLocalization.ambientSizeExponent N (n N) hM (A N) b x < 2 * δ →
