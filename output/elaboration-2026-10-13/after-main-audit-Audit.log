  Filter.Tendsto
    (fun N =>
      RiffleLowerV2.tv (RiffleMain.RandomLower.randomForwardLaw (Q N (TimeProfile.horizonDepth N T)))
        (RiffleLowerV2.uniformPermutation N))
    Filter.atTop (nhds 1)
