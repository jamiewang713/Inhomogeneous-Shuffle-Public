RiffleMain.main {k : ℕ} (hk : 2 ≤ k) (μ : RiffleMain.Profile.NonnegativeTimeLaw k)
  (hμ : RiffleMain.Profile.NonnegativeMeasurableProfile μ)
  (hnd : RiffleMain.Profile.LocallyNondegenerate (RiffleMain.Profile.extendNonnegativeProfile μ))
  (Q : (N K : ℕ) → PMF (TimeProfile.Cuts k N K)) (hQ : RiffleMain.RandomizedProfileLike μ Q) (T : ℝ) (hT : 0 < T)
  (hne : ENNReal.ofReal T ≠ RiffleMain.criticalTime μ) :
  Filter.Tendsto
    (fun N =>
      RiffleLowerV2.tv (RiffleMain.RandomLower.randomForwardLaw (Q N (TimeProfile.horizonDepth N T)))
        (RiffleLowerV2.uniformPermutation N))
    Filter.atTop (nhds (if ENNReal.ofReal T < RiffleMain.criticalTime μ then 1 else 0))
RiffleMain.cutoff {k : ℕ} (hk : 2 ≤ k) (μ : RiffleMain.Profile.NonnegativeTimeLaw k)
  (hμ : RiffleMain.Profile.NonnegativeMeasurableProfile μ)
  (hnd : RiffleMain.Profile.LocallyNondegenerate (RiffleMain.Profile.extendNonnegativeProfile μ))
  (Q : (N K : ℕ) → PMF (TimeProfile.Cuts k N K)) (hQ : RiffleMain.RandomizedProfileLike μ Q)
  (hfinite : RiffleMain.criticalTime μ ≠ ⊤) {ε : ℝ} (hε : 0 < ε) (hε1 : ε < 1) :
  Filter.Tendsto
      (fun N =>
        RiffleLowerV2.tv
          (RiffleMain.RandomLower.randomForwardLaw
            (Q N (TimeProfile.horizonDepth N ((1 - ε) * (RiffleMain.criticalTime μ).toReal))))
          (RiffleLowerV2.uniformPermutation N))
      Filter.atTop (nhds 1) ∧
    Filter.Tendsto
      (fun N =>
        RiffleLowerV2.tv
          (RiffleMain.RandomLower.randomForwardLaw
            (Q N (TimeProfile.horizonDepth N ((1 + ε) * (RiffleMain.criticalTime μ).toReal))))
          (RiffleLowerV2.uniformPermutation N))
      Filter.atTop (nhds 0)
RiffleMain.infinite_critical {k : ℕ} (hk : 2 ≤ k) (μ : RiffleMain.Profile.NonnegativeTimeLaw k)
  (hμ : RiffleMain.Profile.NonnegativeMeasurableProfile μ)
  (hnd : RiffleMain.Profile.LocallyNondegenerate (RiffleMain.Profile.extendNonnegativeProfile μ))
  (Q : (N K : ℕ) → PMF (TimeProfile.Cuts k N K)) (hQ : RiffleMain.RandomizedProfileLike μ Q)
