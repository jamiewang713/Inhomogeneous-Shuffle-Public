RiffleMain.theorem_1_1.{u_1} {k : ℕ} (hk : 2 ≤ k) (μ : RiffleMain.Profile.NonnegativeTimeLaw k)
  (hμ : RiffleMain.Profile.NonnegativeMeasurableProfile μ)
  (hnd : RiffleMain.Profile.LocallyNondegenerate (RiffleMain.Profile.extendNonnegativeProfile μ)) {Ω : ℕ → Type u_1}
  [(N : ℕ) → MeasurableSpace (Ω N)] (ν : (N : ℕ) → MeasureTheory.Measure (Ω N))
  [∀ (N : ℕ), MeasureTheory.IsProbabilityMeasure (ν N)] (X : (N : ℕ) → Ω N → RiffleUpperV2.InfiniteCuts k N)
  (hX : ∀ (N K : ℕ), Measurable fun ω => (X N ω).take K) (hweak : RiffleMain.RandomizedSequenceLike μ ν X) :
  (∀ (T : ℝ),
      0 < T →
        ENNReal.ofReal T ≠ RiffleMain.criticalTime μ →
          Filter.Tendsto (fun N => RiffleMain.sequenceTV ν X hX N T) Filter.atTop
            (nhds (if ENNReal.ofReal T < RiffleMain.criticalTime μ then 1 else 0))) ∧
    (RiffleMain.criticalTime μ ≠ ⊤ →
        ∀ (ε : ℝ),
          0 < ε →
            ε < 1 →
              Filter.Tendsto (fun N => RiffleMain.sequenceTV ν X hX N ((1 - ε) * (RiffleMain.criticalTime μ).toReal))
                  Filter.atTop (nhds 1) ∧
                Filter.Tendsto (fun N => RiffleMain.sequenceTV ν X hX N ((1 + ε) * (RiffleMain.criticalTime μ).toReal))
                  Filter.atTop (nhds 0)) ∧
      (RiffleMain.criticalTime μ = ⊤ →
        ∀ (T : ℝ), 0 < T → Filter.Tendsto (fun N => RiffleMain.sequenceTV ν X hX N T) Filter.atTop (nhds 1))
