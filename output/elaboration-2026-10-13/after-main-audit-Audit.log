  [∀ (N : ℕ), MeasureTheory.IsProbabilityMeasure (ν N)] (X : (N : ℕ) → Ω N → RiffleUpperV2.InfiniteCuts k N)
  (hX : ∀ (N K : ℕ), Measurable fun ω => (X N ω).take K) (hweak : RiffleMain.RandomizedSequenceLike μ ν X) (T : ℝ)
